{
  "name": "thread-signal-website",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test:site": "node scripts/check-site.mjs",
    "refresh:github": "node scripts/refresh-github.mjs",
    "test:github": "node --test scripts/check-github.mjs",
    "test:security": "node --test scripts/check-security.mjs",
    "validate": "npm run check && npm run test:github && npm run test:security && npm run build && npm run test:site",
    "format": "prettier --plugin=prettier-plugin-astro --write src scripts package.json .github/workflows"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "parse5": "^8.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.1",
    "typescript": "^5.9.3"
  }
}
