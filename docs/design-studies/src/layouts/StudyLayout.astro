---
import {
  SITE_NAME,
  OWNER_NAME,
  EMAIL,
  GITHUB_URL,
} from "../../../../src/data/site";
import "../styles/study.css";
interface Props {
  title: string;
  variant: "portfolio" | "case-study";
}
const { title, variant } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta
      name="description"
      content="A grayscale composition study for Thread & Signal."
    />
    <title>{title} · {SITE_NAME}</title>
  </head>
  <body class={variant}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header page-width">
      <a class="wordmark" href="#main">{SITE_NAME}</a>
      <nav aria-label="Main navigation">
        <a href="#work">Work</a>
        <a href="#services">Services</a>
        <a href="#about">About</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer page-width">
      <span>{OWNER_NAME} · Ohio, USA</span>
      <div>
        <a href={GITHUB_URL}>GitHub</a><a href={`mailto:${EMAIL}`}
          >Email Charles</a
        >
      </div>
      <a class="study-return" href="/comparison/" target="_top"
        >Compare the earlier studies</a
      >
    </footer>
  </body>
</html>
