---
import {
  SITE_NAME,
  OWNER_NAME,
  EMAIL,
  GITHUB_URL,
} from "../../../../src/data/site";
import { builds } from "../data/evidence";
import "../styles/offer.css";

const quoteBody = [
  "Hi Charles,",
  "",
  "The repetitive task I'd like to automate (or the AI I want set up):",
  "",
  "What I do now:",
  "What I want to change:",
  "",
  "Thanks,",
].join("\r\n");
const quoteUrl = `mailto:${EMAIL}?subject=${encodeURIComponent("Project quote")}&body=${encodeURIComponent(quoteBody)}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta
      name="description"
      content="Charles Russella automates repetitive work and sets up local AI on your own computer. Real builds: Jetson hardware, Animus Ferric, sdr.rs, SpecuLex."
    />
    <title>Automate repetitive work | {SITE_NAME}</title>
  </head>
  <body>
    <div class="offer-page">
      <header class="offer-header"><p>{SITE_NAME}</p></header>
      <main>
        <section class="offer-intro" aria-labelledby="offer-heading">
          <h1 id="offer-heading">I automate<br />repetitive work.</h1>
          <p class="offer-lead">
            Reports, data entry, moving files between apps — done by a tool
            built for your job.
          </p>
          <a class="offer-action" href={quoteUrl}>Ask for a quote</a>
          <p class="offer-fineprint">
            Scope and price agreed before any work starts.
          </p>
        </section>

        <figure class="offer-hero">
          <img
            src="/jetson-v2-2-render.png"
            width="2160"
            height="1082"
            alt="Three-quarter CAD render of a rectangular Jetson enclosure with a circular fan opening on top and a rectangular side opening."
            decoding="async"
            fetchpriority="high"
          />
          <figcaption>
            CAD render of an enclosure I designed for the Jetson Orin Nano — a
            small computer for running AI locally. Open-source; forked by others
            for software-defined radio.
          </figcaption>
        </figure>

        <section class="offer-services" aria-label="Two ways to start">
          <div>
            <h2>Automate a task</h2>
            <p>A custom tool that does the repetitive work for you.</p>
          </div>
          <div>
            <h2>Set up &amp; test local AI</h2>
            <p>Installed on your own computer and tested on your real task.</p>
          </div>
        </section>

        <section class="offer-builds" aria-label="Other things I build">
          <p class="offer-builds-line">
            Also building:{" "}
            {
              builds.map((b, i) => (
                <Fragment>
                  {i > 0 && <span class="offer-sep"> · </span>}
                  {b.url ? <a href={b.url}>{b.name}</a> : <span>{b.name}</span>}
                  {" "}
                  <span class="offer-build-note">{`(${b.blurb}${b.status ? `, ${b.status}` : ""})`}</span>
                </Fragment>
              ))
            }
          </p>
        </section>
      </main>
      <footer class="offer-footer">
        <p>{OWNER_NAME} · Ohio</p>
        <a href={GITHUB_URL}>View my work</a>
      </footer>
    </div>
  </body>
</html>
