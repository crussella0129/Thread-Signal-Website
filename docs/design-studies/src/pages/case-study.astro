---
import StudyLayout from "../layouts/StudyLayout.astro";
import Evaluation from "../components/Evaluation.astro";
import Hardware from "../components/Hardware.astro";
import Process from "../components/Process.astro";
import Services from "../components/Services.astro";
import About from "../components/About.astro";
import { AUTOMATION_BRIEF_URL } from "../../../../src/data/site";
import { evaluation } from "../data/evidence";
---

<StudyLayout title="Case-study opening" variant="case-study">
  <section class="case-opening page-width" aria-label="Introduction">
    <div class="opening-line">
      <p>Charles Russella · Independent developer &amp; designer</p><p>
        Custom software &amp; local AI
      </p>
    </div>
    <h1>
      Test the result before <br class="desktop-break" />you trust the
      automation.
    </h1>
    <div class="case-deck">
      <p>
        I build custom software and local AI systems around your workflows,
        tools, and hardware. Start by defining what a useful result must do.
      </p>
      <a class="action" href={AUTOMATION_BRIEF_URL}
        >Discuss a workflow <span aria-hidden="true">↗</span></a
      >
    </div>
  </section>
  <section id="work" aria-labelledby="case-heading">
    <div class="case-evidence-band">
      <div class="case-evidence page-width">
        <div>
          <p class="project-kind">Local AI evaluation · Animus Ferric</p>
          <h2 id="case-heading">
            A small model.<br />A specific task.<br />An actual check.
          </h2>
          <p>
            Could a small local coding model finish an inventory reorder
            feature? This evaluation gave it a specific contract, then checked
            the result.
          </p>
          <p>
            The required output was a sorted list of reorder records. The
            model's code returned a keyed dictionary. The contract check failed.
          </p>
          <p class="caption">
            {evaluation.model} · {evaluation.date}<br />Public project
            evaluation, not a client deployment.
          </p>
        </div>
        <Evaluation />
      </div>
    </div>
    <div class="case-conclusion page-width">
      <h3>The result did not pass.<br />The next step wasn't deployment.</h3>
      <div>
        <p>
          The run stopped without an accepted completion. The proposed
          improvement was rejected. A feasibility assessment should make that
          decision possible before your workflow depends on it.
        </p><a class="text-link" href={evaluation.trace}
          >Inspect the actual run <span aria-hidden="true">↗</span></a
        >
      </div>
    </div>
  </section>
  <Services />
  <Hardware compact />
  <Process />
  <About />
</StudyLayout>
