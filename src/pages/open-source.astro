---
import BaseLayout from "../layouts/BaseLayout.astro";
import snapshot from "../data/github.json";
import { validSnapshot } from "../data/github-schema.mjs";
import { projectNotes } from "../data/project-notes";
import { GITHUB_URL } from "../data/site";
if (!validSnapshot(snapshot))
  throw new Error(
    "Invalid GitHub project snapshot; refusing to render untrusted links.",
  );
const updated = new Date(snapshot.updatedAt).toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
---

<BaseLayout
  title="Open-Source Dev"
  description="Free and open-source software is central to Thread & Signal. Explore our most-starred GitHub projects, from local AI tools to Jetson hardware."
>
  <div class="container page">
    <header class="page-intro">
      <p class="eyebrow">Open-Source Dev</p>
      <h1>Built to be shared.</h1>
      <p class="lead">
        Contributing to and maintaining free and open-source software is a core
        part of how we do business.
      </p>
      <p class="intro-note">
        Our work spans local AI assistants, tools for AI-assisted development,
        and hardware designs. See each repository for its license and usage
        terms.
      </p>
    </header>
    <div class="list-heading">
      <h2>Most-starred projects</h2><p class="small muted">
        Updated <time datetime={snapshot.updatedAt}>{updated}</time> · Refreshes daily
      </p>
    </div>
    <ol
      class="projects"
      aria-label="Five most-starred original GitHub projects"
    >
      {
        snapshot.repositories.map((repo) => {
          const note = projectNotes[repo.name];
          return (
            <li data-repository={repo.name}>
              <article>
                <div>
                  <div class="project-heading">
                    <>
                      <h3>
                        <a href={repo.url}>
                          {note?.title || repo.name}{" "}
                          <span aria-hidden="true">↗</span>
                        </a>
                      </h3>
                      <span
                        class="stars"
                        aria-label={`${repo.stars} GitHub stars`}
                      >
                        {repo.stars} stars
                      </span>
                    </>
                  </div>
                  {(note?.status || repo.archived) && (
                    <p class="status">{note?.status || "Archived"}</p>
                  )}
                  <p class="project-summary">
                    {note?.summary ||
                      repo.description ||
                      "View the source, documentation, and latest work on GitHub."}
                  </p>
                </div>
              </article>
            </li>
          );
        })
      }
    </ol>
    <a class="text-link closing" href={GITHUB_URL}
      >Explore all our projects <span aria-hidden="true">↗</span></a
    >
  </div>
</BaseLayout>
<style>
  .intro-note {
    margin-top: var(--s5);
    max-width: var(--measure);
    color: var(--muted);
  }
  .list-heading {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s3) var(--s6);
    align-items: baseline;
    margin-bottom: var(--s6);
  }
  .list-heading h2 {
    font-size: var(--text-lead);
  }
  .projects {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .projects li {
    border-top: var(--stroke) solid var(--rule);
    padding-block: var(--s8);
  }
  .projects li:last-child {
    border-bottom: var(--stroke) solid var(--rule);
  }
  .project-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s4);
  }
  h3 {
    font-size: var(--text-lead);
    font-weight: 400;
    letter-spacing: var(--tracking-wordmark);
  }
  h3 a {
    display: inline-block;
    padding-block: var(--s2);
  }
  .stars {
    font-size: var(--text-sm);
    color: var(--muted);
    white-space: nowrap;
  }
  .project-summary {
    margin-top: var(--s3);
    max-width: 64ch;
    color: var(--muted);
  }
  .status {
    font-size: var(--text-sm);
    color: var(--muted);
  }
  @media (max-width: 640px) {
    .project-heading {
      flex-wrap: wrap;
      gap: 0 var(--s4);
    }
  }
</style>
