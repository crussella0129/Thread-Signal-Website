---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_URL, EMAIL } from '../data/site';

const description =
  'Agent skills that work across every harness — Sprint Loops, GECK, and MDR run on Claude Code, Codex CLI, Antigravity, and open local harnesses. Custom skill development and agentic-development workshops available.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Agent Skill Development & Agentic Development Workshops',
  serviceType: 'AI tooling and training',
  description:
    'Custom harness-agnostic agent skills and protocols for engineering teams, plus hands-on workshops in agentic development with Claude Code, Codex CLI, and local model harnesses.',
  provider: { '@type': 'Organization', name: 'Thread & Signal', url: SITE_URL },
  url: `${SITE_URL}/skills`,
};
---

<BaseLayout title="Agent Skills — Harness-Agnostic Tooling" description={description} jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="section container skills-hero">
    <p class="page-tag">Agent Skills</p>
    <h1>Skills your agents keep<br /><span class="highlight">when you switch harnesses.</span></h1>
    <p class="lead">
      Every AI vendor wants to lock your workflows into their runtime. We build the opposite:
      <strong>brand-agnostic, cross-compatible agent skills</strong> — protocols and tools that
      run identically on Claude Code, Codex CLI, Antigravity, and open local harnesses.
      Your process shouldn't be a hostage of your subscription.
    </p>
  </section>

  <div class="geo-divider"></div>

  <!-- The skills line -->
  <section class="section container">
    <h2 class="section-title">The Skills Line</h2>
    <p class="section-subtitle">
      Open source, in production use, and installable today.
    </p>

    <div class="skill-list">
      <div class="card skill-detail">
        <div class="skill-header">
          <h3><a href="https://github.com/crussella0129/sprint-loops" target="_blank" rel="noopener">Sprint Loops</a></h3>
          <span class="skill-kind">Loop engineering protocol</span>
        </div>
        <p>
          <strong>The problem:</strong> long-horizon autonomous coding drifts — agents lose the
          plot across sessions, redo work, and leave no audit trail.
          <br />
          <strong>The skill:</strong> a lightweight five-phase protocol (Research → Plan → Build →
          Test → Loop) with persistent state on disk. The filesystem is the state machine. Ships
          three ways: a Claude Code plugin marketplace, a Codex CLI skill, and a runtime-agnostic
          spec for open harnesses.
        </p>
      </div>

      <div class="card skill-detail">
        <div class="skill-header">
          <h3><a href="https://github.com/crussella0129/GECK" target="_blank" rel="noopener">GECK</a></h3>
          <span class="skill-kind">Structured memory framework</span>
        </div>
        <p>
          <strong>The problem:</strong> context amnesia. Every CLI-agent session starts from zero —
          repeated mistakes, forgotten decisions, no coherence across a large project.
          <br />
          <strong>The skill:</strong> the Garden of Eden Creation Kit — a protocol plus generator
          that gives agents typed tasks, decision records, learnings, and episodic logs in a
          structured folder, read within a declared context budget.
        </p>
      </div>

      <div class="card skill-detail">
        <div class="skill-header">
          <h3><a href="https://github.com/crussella0129/MDR" target="_blank" rel="noopener">MDR</a></h3>
          <span class="skill-kind">Download resilience skill</span>
        </div>
        <p>
          <strong>The problem:</strong> multi-hour, multi-gigabyte model downloads from HuggingFace
          die at 87% and nobody notices until morning.
          <br />
          <strong>The skill:</strong> Massive Download Resilience — procurement of large models
          with nested cron jobs that watch, resume, and verify until the weights are truly on disk.
          Works from Claude Code, Codex, and Antigravity.
        </p>
      </div>
    </div>

    <p class="supporting-note">
      Supporting cast: <a href="https://github.com/crussella0129/oovra" target="_blank" rel="noopener">oovra</a>
      (compose and diff agentic system prompts from standardized .md + TOML elements) and
      <a href="https://github.com/crussella0129/.lux" target="_blank" rel="noopener">.lux</a>
      (a document format designed for human <em>and</em> AI readers as first-class consumers).
    </p>
  </section>

  <div class="geo-divider"></div>

  <!-- Offers -->
  <section class="section container">
    <h2 class="section-title">Two Ways to Work With Us</h2>

    <div class="offer-grid">
      <div class="card offer">
        <h3>Custom Skill &amp; Protocol Development</h3>
        <p>
          Your team has a workflow — code review, release management, data pipeline babysitting —
          that an agent should run reliably. We design and build it as a portable skill:
          documented, versioned, and working across the harnesses you already use.
          One protocol, every runtime.
        </p>
        <a href="/contact" class="btn btn-primary">Scope a Skill</a>
      </div>
      <div class="card offer">
        <h3>Agentic Development Workshops</h3>
        <p>
          Hands-on training for engineering teams: how to actually work with Claude Code, Codex
          CLI, and local harnesses — loop engineering, context management, permission models,
          and the habits that separate "tried the demo" from "shipped with agents."
          Remote or on-site, sized to your team.
        </p>
        <a href="/contact" class="btn btn-primary">Book a Workshop</a>
      </div>
    </div>

    <div class="cta-block">
      <p class="cta-note">Questions first? Email <a href={`mailto:${EMAIL}`}>{EMAIL}</a>.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .skills-hero {
    padding-top: 5rem;
    max-width: 820px;
  }

  .page-tag {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
  }

  .highlight { color: var(--accent); }

  .lead {
    color: var(--text-muted);
    font-size: 1.15rem;
    line-height: 1.7;
    margin: 1.5rem 0 0;
  }

  .skill-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .skill-header {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }

  .skill-header h3 {
    font-size: 1.2rem;
  }

  .skill-kind {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.3rem 0.75rem;
    border-radius: 99px;
    background: rgba(0, 212, 255, 0.08);
    color: var(--accent);
    border: 1px solid rgba(0, 212, 255, 0.15);
  }

  .skill-detail p {
    color: var(--text-muted);
    line-height: 1.7;
    font-size: 0.97rem;
  }

  .supporting-note {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-top: 2rem;
    line-height: 1.7;
  }

  .offer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .offer h3 {
    color: var(--accent);
    font-size: 1.1rem;
    margin-bottom: 0.75rem;
  }

  .offer p {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }

  .cta-block {
    text-align: center;
    margin-top: 2.5rem;
  }

  .cta-note {
    color: var(--text-muted);
    font-size: 0.9rem;
  }
</style>
