---
import BaseLayout from '../layouts/BaseLayout.astro';
import { EMAIL } from '../data/site';

const description =
  'Services from Thread & Signal: business process automation, custom agentic development in Rust and Python, edge AI deployment with llama.cpp, agent skills and workshops, CAD and 3D design commissions and lessons.';
---

<BaseLayout title="Services" description={description}>
  <section class="section container">
    <p class="eyebrow">The workshop's ledger</p>
    <h1 class="section-title">Five ways to commission us.</h1>
    <p class="section-subtitle">
      Every engagement starts with a short consult, then a scoped,
      fixed-deliverable build — no open-ended retainers unless you want one.
    </p>

    <div class="service-list">
      <div class="card service-detail">
        <div class="service-header">
          <span class="service-icon">&#8644;</span>
          <h2>Business Process Automation</h2>
        </div>
        <p>
          The workflows eating your team's hours — data entry, report generation, file wrangling,
          multi-system handoffs — rebuilt as reliable automations. Agentic where judgment is
          needed, deterministic where it isn't. Delivered as maintainable code you own,
          not a no-code subscription you rent.
        </p>
        <div class="service-tags">
          <span class="tag">Python</span>
          <span class="tag">Rust</span>
          <span class="tag">Agentic Workflows</span>
          <span class="tag">Windows &amp; Linux</span>
        </div>
      </div>

      <div class="card service-detail">
        <div class="service-header">
          <span class="service-icon">{ }</span>
          <h2>Custom Agentic Development</h2>
        </div>
        <p>
          Desktop applications, CLI tools, CAD software plugins, and systems software — developed
          with agentic tooling (Claude Code, Antigravity) at production quality, primarily in Rust
          and Python. You get the velocity of AI-assisted development with the discipline of
          per-task commits, tests, and traceable decisions.
        </p>
        <div class="service-tags">
          <span class="tag">Rust</span>
          <span class="tag">Python</span>
          <span class="tag">Desktop Apps</span>
          <span class="tag">CAD Plugins</span>
        </div>
      </div>

      <div class="card service-detail">
        <div class="service-header">
          <span class="service-icon">&#9733;</span>
          <h2>Edge AI &amp; Local LLM Deployment</h2>
        </div>
        <p>
          llama.cpp servers with custom harnesses on your workstations, on-prem servers, or
          Jetson-class devices. Model selection, quantization, serving, and the agent loop on
          top — proven by the open-source <a href="/animus">Animus Ferric</a> harness.
          For teams whose code and data can't leave the building.
        </p>
        <div class="service-tags">
          <span class="tag">llama.cpp</span>
          <span class="tag">Local Models</span>
          <span class="tag">Nvidia Jetson</span>
          <span class="tag">On-Prem</span>
        </div>
      </div>

      <div class="card service-detail">
        <div class="service-header">
          <span class="service-icon">&#10022;</span>
          <h2>Agent Skills &amp; Workshops</h2>
        </div>
        <p>
          Custom harness-agnostic skills for your team's workflows — built on the same architecture
          as <a href="/skills">Sprint Loops, GECK, and MDR</a> — plus hands-on agentic-development
          workshops: loop engineering, context management, and the habits that make AI-assisted
          teams actually ship.
        </p>
        <div class="service-tags">
          <span class="tag">Claude Code</span>
          <span class="tag">Codex CLI</span>
          <span class="tag">Team Training</span>
          <span class="tag">Protocols</span>
        </div>
      </div>

      <div class="card service-detail">
        <div class="service-header">
          <span class="service-icon">&#9650;</span>
          <h2>CAD &amp; 3D Design — Commissions &amp; Lessons</h2>
        </div>
        <p>
          Commissioned parametric designs — jigs &amp; fixtures, corporate branded gear, gaming
          assets, manufacturing equipment — delivered print-ready. And <a href="/design">1-on-1
          Autodesk Fusion courses</a> in geometry and additive manufacturing for commercial,
          enthusiast, and academic students.
        </p>
        <div class="service-tags">
          <span class="tag">Autodesk Fusion</span>
          <span class="tag">3D Printing</span>
          <span class="tag">Jigs &amp; Fixtures</span>
          <span class="tag">1-on-1 Lessons</span>
        </div>
      </div>
    </div>
  </section>

  <div class="geo-divider"></div>

  <section class="section container commission-how reveal">
    <h2 style="text-align: center;">How a commission works</h2>
    <div class="steps reveal-stagger">
      <div class="step">
        <p class="numeral">01</p>
        <h3>The conversation</h3>
        <p>A short consult to understand the problem — what eats your hours, what can't leave your building, what you want to hold in your hands.</p>
      </div>
      <div class="step">
        <p class="numeral">02</p>
        <h3>The pattern</h3>
        <p>A scoped proposal with concrete deliverables and a fixed shape — you know what's being woven before the loom starts.</p>
      </div>
      <div class="step">
        <p class="numeral">03</p>
        <h3>The build</h3>
        <p>Progress you can watch in a repo, commit by commit, until the work is in your hands and running on your hardware.</p>
      </div>
    </div>
    <div style="text-align: center; margin-top: 2.5rem;">
      <a href="/contact" class="btn btn-primary">Commission a build</a>
      <p class="cta-note">Or email <a href={`mailto:${EMAIL}`}>{EMAIL}</a> directly.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .service-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .service-detail p {
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 1.25rem;
  }

  .service-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .service-icon {
    font-size: 1.5rem;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: var(--accent-glow);
    flex-shrink: 0;
  }

  .service-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.3rem 0.75rem;
    border-radius: 99px;
    background: var(--accent-glow);
    color: var(--accent);
    border: 1px solid rgba(232, 163, 61, 0.22);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 2rem;
    max-width: 960px;
    margin: 2.5rem auto 0;
  }

  .step .numeral {
    margin-bottom: 0.6rem;
  }

  .step h3 {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }

  .step p {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .cta-note {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-top: 1rem;
  }
</style>
