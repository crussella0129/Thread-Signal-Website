---
import BaseLayout from "../layouts/BaseLayout.astro";
const offers = [
  {
    title: "Stop copying and pasting.",
    description:
      "Turn spreadsheets, emails, and forms into finished reports or updated records. We build and test one tool around the job you repeat.",
    price: "Scope-based pricing",
    unit: "to see how we can help.",
    contact: true,
  },
  {
    title: "Put Local AI to work.",
    description:
      "We check your hardware or recommend what you need, then set up compatible local AI models and tools like Hermes Agent. We build and test document and workflow tasks, including overnight jobs where suitable, with agreed limits and human review.",
    price: "Starting at $750",
    unit: "for hardware planning, setup, and testing",
    disclosure:
      "Hardware is not included. Computers and accessories, including any pictured Jetson, are purchased separately.",
    expectations:
      "AI can make mistakes. Speed and accuracy depend on your hardware, data, and task.",
  },
  {
    title: "Help your team use it.",
    description:
      "A hands-on session using your everyday tasks. Your team practices, asks questions, and leaves with simple instructions to follow.",
    price: "Starting at $400",
    unit: "for a team training session",
  },
];
---

<BaseLayout
  title="Services Offered"
  description="Task automation, local AI hardware advice and setup, and team training. Local AI services start at $750; training starts at $400. Hardware is not included."
>
  <div class="container page">
    <header class="page-intro">
      <p class="eyebrow">Services Offered</p>
      <h1>Start with the task<br />you’re tired of doing.</h1>
    </header>
    <ul class="offers" aria-label="Services and starting prices">
      {
        offers.map((offer) => (
          <li>
            <>
              <h2>{offer.title}</h2>
              <div>
                <>
                  <p>{offer.description}</p>
                  <p class="budget">
                    <strong>{offer.price + (offer.contact ? ";" : "")}</strong>{" "}
                    {offer.contact ? (
                      <>
                        <a href="/contact/">Tell us more</a>{" "}
                        <span>{offer.unit}</span>
                      </>
                    ) : (
                      <span>{offer.unit}</span>
                    )}
                  </p>
                  {offer.disclosure && (
                    <p class="offer-disclosure">{offer.disclosure}</p>
                  )}
                  {offer.expectations && (
                    <p class="offer-expectations">{offer.expectations}</p>
                  )}
                </>
              </div>
            </>
          </li>
        ))
      }
    </ul>
    <div class="closing">
      <p class="budget-note">
        Starting prices are for services in USD; final pricing depends on scope.
        Hardware is purchased separately. Paid software, usage fees, and ongoing
        support are additional unless included in your written quote. We agree
        on deliverables and price before work starts.
      </p>
      <a class="action" href="/contact/">Tell us about your task</a>
    </div>
  </div>
</BaseLayout>
<style>
  .offers {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .offers li {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: var(--s8);
    padding-block: var(--s8);
    border-top: var(--stroke) solid var(--rule);
  }
  .offers li:last-child {
    border-bottom: var(--stroke) solid var(--rule);
  }
  .offers li > div > p:first-child {
    color: var(--muted);
    max-width: var(--measure);
  }
  .budget {
    margin-top: var(--s4);
  }
  .budget strong {
    font-weight: 400;
  }
  .budget span {
    color: var(--muted);
  }
  .offer-disclosure,
  .offer-expectations {
    margin-top: var(--s3);
    max-width: var(--measure);
    font-size: var(--text-sm);
    color: var(--muted);
  }
  .closing {
    margin-top: var(--s6);
  }
  .closing .budget-note {
    max-width: 75ch;
    font-size: var(--text-base);
  }
  .closing .action {
    margin-top: var(--s8);
  }
  @media (max-width: 640px) {
    .offers li {
      grid-template-columns: 1fr;
      gap: var(--s4);
    }
  }
</style>
