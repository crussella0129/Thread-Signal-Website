---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_URL, EMAIL, OWNER_NAME } from '../data/site';

const description =
  'Local LLM deployment and custom AI agent harnesses, informed by Animus Ferric: a Rust project for small local models. Assess your workflow and hardware.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareSourceCode',
    name: 'Animus Ferric',
    description:
      'Rust-native agentic coding harness purpose-built for small local models (1B–14B GGUF): harness-owned constrained decoding, deterministic model-scale policies, trajectory-first observability.',
    codeRepository: 'https://github.com/crussella0129/Animus_Ferric',
    programmingLanguage: 'Rust',
    author: { '@type': 'Person', name: OWNER_NAME },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Custom Agent Harness Implementation & Edge AI Deployment',
    serviceType: 'AI infrastructure consulting',
    description:
      'Paid implementations of the Animus harness and custom local-LLM deployments: llama.cpp servers with custom harnesses, on-prem agentic coding, Jetson-class edge hardware.',
    provider: { '@type': 'Organization', name: 'Thread & Signal', url: SITE_URL },
    url: `${SITE_URL}/animus`,
  },
];
---

<BaseLayout title="Local LLM Deployment & AI Agents — Animus" description={description} jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="section container animus-hero">
    <p class="eyebrow">The Animus Project</p>
    <h1><span class="ink-gradient">Intelligence that stays home.</span></h1>
    <p class="lead">
      Put inference on hardware you control, with an agent workflow designed
      around your tools and data. Animus Ferric is a public Rust project built
      for <strong>small local models (1B–14B GGUF)</strong>. It informs the
      custom harness and local LLM deployment services offered here; each
      workload and hardware combination needs its own evaluation.
    </p>
    <div class="hero-cta">
      <a href="https://github.com/crussella0129/Animus_Ferric" class="btn btn-primary" target="_blank" rel="noopener">Ferric on GitHub</a>
      <a href="#hire" class="btn btn-outline">Commission an implementation</a>
    </div>
  </section>

  <div class="geo-divider"></div>

  <!-- The lineage: one thread, four knots -->
  <section class="section container">
    <p class="eyebrow">The lineage</p>
    <h2 class="section-title">Four implementations to get it right.</h2>
    <p class="section-subtitle">
      Animus wasn't designed in one sitting — it was earned. Three earlier
      implementations are dormant in public repos, and each one taught us
      something the next one kept. That history is the feature: every conviction
      in Ferric was paid for with working code.
    </p>

    <ol class="lineage reveal-stagger">
      <span class="lineage-thread" aria-hidden="true"></span>

      <li class="lineage-step">
        <span class="lineage-node" aria-hidden="true"></span>
        <div class="card lineage-card">
          <div class="lineage-head">
            <span class="lineage-lang">Python</span>
          </div>
          <h3><a href="https://github.com/crussella0129/Animus" target="_blank" rel="noopener">Animus</a></h3>
          <p>
            The original prototype: an open-source, natively running agentic CLI.
            It explored the local-agent workflow and established the starting
            point for later work on bounded tool use and execution traces.
          </p>
        </div>
      </li>

      <li class="lineage-step">
        <span class="lineage-node" aria-hidden="true"></span>
        <div class="card lineage-card">
          <div class="lineage-head">
            <span class="lineage-lang">Go</span>
          </div>
          <h3><a href="https://github.com/crussella0129/Animus_Prion" target="_blank" rel="noopener">Animus Prion</a></h3>
          <p>
            The rebuild for speed and static binaries. Prion sharpened the
            tool-calling loop and showed how much discipline small models need
            from the harness around them.
          </p>
        </div>
      </li>

      <li class="lineage-step">
        <span class="lineage-node" aria-hidden="true"></span>
        <div class="card lineage-card">
          <div class="lineage-head">
            <span class="lineage-lang">Go</span>
          </div>
          <h3><a href="https://github.com/crussella0129/fev" target="_blank" rel="noopener">fev</a></h3>
          <p>
            A local-first assistant for navigating the digital space. fev
            explored the personal-agent side of the problem and clarified what
            belongs in the harness versus the model.
          </p>
        </div>
      </li>

      <li class="lineage-step">
        <span class="lineage-node lineage-node-active" aria-hidden="true"></span>
        <div class="card card-copper lineage-card lineage-current">
          <div class="lineage-head">
            <span class="lineage-lang">Rust</span>
            <span class="badge-active">Active</span>
          </div>
          <h3><a href="https://github.com/crussella0129/Animus_Ferric" target="_blank" rel="noopener">Animus Ferric</a></h3>
          <p>
            The Rust synthesis of the earlier implementations: a harness that owns decoding, scales
            its behavior to the model, and treats the trajectory as the source of
            truth.
          </p>
        </div>
      </li>
    </ol>
  </section>

  <div class="geo-divider"></div>

  <!-- Three convictions -->
  <section class="section container">
    <p class="eyebrow">The convictions</p>
    <h2 class="section-title">Three rules, paid for in working code.</h2>
    <div class="convictions-grid reveal-stagger">
      <div class="card card-copper conviction">
        <p class="numeral">01</p>
        <h3>The harness owns decoding</h3>
        <p>
          Constrained generation — JSON-Schema, regex, and CFG grammars — is
          requested by the harness and enforced by supported inference backends.
          This constrains tool-call structure. Valid structure does not guarantee
          a correct action, so tool validation, permissions, and evaluation still matter.
        </p>
      </div>
      <div class="card card-copper conviction">
        <p class="numeral">02</p>
        <h3>Behavior scales to the model, deterministically</h3>
        <p>
          A pure function maps a model profile — parameters, quantization,
          context, measured capability — to a run policy: protocol, plan
          granularity, turn budgets, tool count. A 3B model gets 3B-sized steps.
          No guesswork, no vibes.
        </p>
      </div>
      <div class="card card-copper conviction">
        <p class="numeral">03</p>
        <h3>The trajectory is the source of truth</h3>
        <p>
          Every session writes a versioned JSONL trace — full conversation, tool
          calls, untruncated output, execution chain — replayable and diffable.
          If it isn't in the trace, it didn't happen.
        </p>
      </div>
    </div>
  </section>

  <div class="geo-divider"></div>

  <!-- Paid offer -->
  <section id="hire" class="section container">
    <p class="eyebrow">The commission</p>
    <h2 class="section-title">Open source project. Paid implementations.</h2>
    <p class="section-subtitle">
      Explore Ferric's public source and documentation, including the
      <a href="https://github.com/crussella0129/Animus_Ferric" target="_blank" rel="noopener">project's current licensing information</a>.
      What I sell is the implementation work:
      making local agents work on <em>your</em> hardware, against <em>your</em>
      codebase, inside <em>your</em> security boundary.
    </p>

    <div class="offer-grid reveal-stagger">
      <div class="card offer">
        <h3>Custom harness implementations</h3>
        <p>
          Ferric (or a purpose-built harness) adapted to your environment: your
          tool surface, your permission model, your models. Constrained decoding
          tuned to the workflows your team actually runs.
        </p>
      </div>
      <div class="card offer">
        <h3>Edge AI deployments</h3>
        <p>
          llama.cpp servers with custom harnesses on workstations, on-prem
          servers, and Jetson-class edge devices. The scope can include model
          selection, quantization, serving, and the agent loop, with hardware
          support verified against the chosen inference backend.
        </p>
      </div>
      <div class="card offer">
        <h3>Local-agent strategy</h3>
        <p>
          Not sure whether a 7B model on your hardware can carry your workload?
          Ferric includes a capability ladder (L0–L6) for evaluating model behavior.
          We can scope a benchmark using representative tasks and your hardware,
          then use the results to guide an implementation decision.
        </p>
      </div>
    </div>

    <div class="cta-block">
      <a href="/contact" class="btn btn-primary">Commission a build</a>
      <p class="cta-note">Or email <a href={`mailto:${EMAIL}`}>{EMAIL}</a> with a sketch of your environment.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .animus-hero {
    position: relative;
    padding-top: 5rem;
    max-width: 860px;
  }

  /* Warp-thread motif behind the hero. */
  .animus-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      90deg,
      rgba(232, 163, 61, 0.05) 0 1px,
      transparent 1px 56px
    );
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.7), transparent 85%);
    pointer-events: none;
  }

  .lead {
    color: var(--text-muted);
    font-size: 1.15rem;
    line-height: 1.7;
    margin: 1.5rem 0 2rem;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* ── Lineage timeline: one thread, four knots ── */
  .lineage {
    position: relative;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-left: 2.25rem;
  }

  .lineage-thread {
    position: absolute;
    left: 8px;
    top: 12px;
    bottom: 12px;
    width: 1px;
    background: linear-gradient(
      180deg,
      rgba(236, 229, 216, 0.12) 0%,
      rgba(236, 229, 216, 0.18) 55%,
      var(--accent) 100%
    );
  }

  .lineage-step {
    position: relative;
  }

  .lineage-node {
    position: absolute;
    left: calc(-2.25rem + 4px);
    top: 2rem;
    width: 9px;
    height: 9px;
    transform: rotate(45deg);
    background: var(--bg);
    border: 1px solid var(--text-muted);
  }

  .lineage-node-active {
    border-color: var(--accent);
    background: var(--accent);
    box-shadow: 0 0 14px var(--accent-glow);
  }

  .lineage-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.6rem;
  }

  .lineage-card h3 {
    margin-bottom: 0.6rem;
    font-size: 1.15rem;
  }

  .lineage-card p {
    color: var(--text-muted);
    font-size: 0.94rem;
    line-height: 1.65;
  }

  .lineage-lang {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.25rem 0.7rem;
    border-radius: 99px;
    background: rgba(236, 229, 216, 0.06);
    color: var(--text-muted);
    border: 1px solid var(--border);
  }

  .lineage-current {
    box-shadow: 0 0 28px var(--accent-glow);
  }

  .badge-active {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    padding: 0.2rem 0.55rem;
    border-radius: 99px;
    background: var(--accent-glow);
    color: var(--accent);
    border: 1px solid rgba(232, 163, 61, 0.35);
  }

  /* ── Convictions & offers ── */
  .convictions-grid,
  .offer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }

  .conviction .numeral {
    margin-bottom: 0.75rem;
  }

  .conviction h3,
  .offer h3 {
    font-size: 1.1rem;
    margin-bottom: 0.75rem;
  }

  .conviction p,
  .offer p {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .cta-block {
    text-align: center;
    margin-top: 3rem;
  }

  .cta-note {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-top: 1rem;
  }

  @media (min-width: 900px) {
    .lineage {
      flex-direction: row;
      padding-left: 0;
      padding-top: 2.25rem;
      gap: 1.5rem;
    }

    .lineage-thread {
      left: 12px;
      right: 12px;
      top: 8px;
      bottom: auto;
      width: auto;
      height: 1px;
      background: linear-gradient(
        90deg,
        rgba(236, 229, 216, 0.12) 0%,
        rgba(236, 229, 216, 0.18) 55%,
        var(--accent) 100%
      );
    }

    .lineage-step {
      flex: 1;
    }

    .lineage-node {
      left: 2rem;
      top: calc(-2.25rem + 4px);
    }
  }
</style>
