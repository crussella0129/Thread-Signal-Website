---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import jetson from "../assets/jetson-v3.1a-photo.webp";
import jetsonCad from "../assets/jetson-v3.1a-cad.png";
import { GITHUB_URL } from "../data/site";
---

<BaseLayout title="We automate repetitive work">
  <div class="container home">
    <section class="home-intro" aria-labelledby="home-title">
      <h1 id="home-title">We automate<br />repetitive work.</h1>
      <p class="lead">
        Reports. Data entry. Moving information between apps. We build tools and
        set up AI to do the busywork for you.
      </p>
      <a class="action" href="/services/">See our services</a>
      <a class="text-link" href="/contact/"
        >Tell us what takes too long <span aria-hidden="true">→</span></a
      >
    </section>
    <figure>
      <div class="hero-images">
        <div class="media-frame home-photo home-cad">
          <Image
            src={jetsonCad}
            alt="CAD design of our Jetson case, showing the fan opening, buttons, and computer ports."
            widths={[480, 800, 1200]}
            sizes="(max-width: 760px) 100vw, 50vw"
            format="webp"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <div class="media-frame home-photo">
          <Image
            src={jetson}
            alt="The finished 3D-printed Jetson case held in one hand, with the fan and computer ports visible."
            widths={[480, 800, 1200]}
            sizes="(max-width: 760px) 100vw, 50vw"
            format="webp"
            loading="lazy"
          />
        </div>
      </div>
      <figcaption>
        Pictured here: <a href={`${GITHUB_URL}/Jetson-Orin-Nano-Super-Case`}
          >Nvidia Jetson Orin Nano Super Case v3.1a</a
        >
      </figcaption>
    </figure>
  </div>
</BaseLayout>
<style>
  .home {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    align-items: center;
    gap: var(--s12);
    padding-block: var(--section-gap);
  }
  h1 {
    font-size: var(--text-home);
  }
  .home-intro .action {
    margin-top: var(--s8);
  }
  .home-intro > .text-link {
    display: flex;
    width: fit-content;
    margin-top: var(--s4);
    color: var(--muted);
  }
  .hero-images {
    display: grid;
    gap: var(--s4);
  }
  .home-photo img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    object-position: 50% 60%;
  }
  .home-cad img {
    object-position: center;
    filter: grayscale(1);
  }
  figcaption {
    margin-top: var(--s4);
  }
  @media (max-width: 760px) {
    .home {
      grid-template-columns: 1fr;
      gap: var(--s10);
    }
    .home-photo img {
      aspect-ratio: 4 / 3;
    }
  }
</style>
