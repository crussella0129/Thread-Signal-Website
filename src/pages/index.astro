---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import CallActions from "../components/CallActions.astro";
import LoopFigure from "../components/LoopFigure.astro";
import yardulumIcon from "../assets/yardulum-icon.png";
import { PITCH } from "../data/site";
---

<BaseLayout
  title="Yardulum, a sales tool for landscapers"
  description="Yardulum is a sales tool we’re building for landscapers in Northeast Ohio: a model of your customer’s yard, with every item priced from your own price list. In development."
>
  <section id="hero" class="hero container" aria-labelledby="home-title">
    <div class="hero-text">
      <p class="kicker">
        <Image
          src={yardulumIcon}
          alt="Yardulum"
          width={28}
          height={28}
          densities={[1, 2, 3]}
          loading="eager"
        />
        <span class="kicker-name" aria-hidden="true">Yardulum</span>
        <span class="chip">In development</span>
      </p>
      <h1 id="home-title">
        <span class="beat">Their yard.</span>
        <span class="beat">Your design.</span>
        <span class="beat">Your prices.</span>
        <span class="beat">Closed at the table.</span>
      </h1>
      <p class="lead">{PITCH}</p>
      <CallActions />
      <p class="byline">
        Charles Russella is building it in Kent, Ohio. He ran his own
        landscaping and leaf-removal business.
      </p>
    </div>
    <LoopFigure />
  </section>
  <div class="container home-rest">
    <section class="section" aria-labelledby="quote-heading">
      <h2 id="quote-heading">Where a quote goes wrong</h2>
      <p>
        A quote written in the truck can get the big items right and still miss
        the small ones.
      </p>
      <ul class="stories">
        <li>
          <h3>Short on mulch</h3>
          <p>
            Eyeball a bed at two yards and it takes three. Measure it, and 324
            sq ft at 3 inches is 3 cubic yards.
          </p>
        </li>
        <li>
          <h3>Haul-off left off</h3>
          <p>
            The old sod has to go somewhere. Leave it off the quote and the crew
            hauls it for free.
          </p>
        </li>
        <li>
          <h3>The slope nobody saw</h3>
          <p>
            A yard can look flat from the driveway and still fall toward the
            street. On the model, the slope shows before anyone prices the
            grading.
          </p>
        </li>
      </ul>
      <p>
        We’re building Yardulum so haul-off, grading and the rest are items you
        pick from your own price list, priced the same way on every job.
      </p>
    </section>
    <section class="section" aria-labelledby="club-heading">
      <h2 id="club-heading">Ask about the Founders Club</h2>
      <p>
        Every company that takes part while we build Yardulum joins the Founders
        Club and keeps founder pricing for life, locked for as long as they stay
        subscribed. Charles sets you up at your shop, with sales training for
        you and whoever sells for you. In return, he asks for about 30 minutes
        every two weeks to hear what works and what doesn’t.
      </p>
      <a class="text-link" href="/founders-club/"
        >How the Founders Club works <span aria-hidden="true">→</span></a
      >
    </section>
    <section class="section" aria-labelledby="call-heading">
      <h2 id="call-heading">Call or text Charles</h2>
      <p>
        He’ll show you the property model in person and tell you where the rest
        stands. If he misses your call, he’ll call you back.
      </p>
      <CallActions />
    </section>
  </div>
</BaseLayout>
<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.12fr);
    column-gap: var(--s12);
    align-items: start;
    padding-top: var(--s10);
  }
  .kicker {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s3);
  }
  .kicker img {
    width: 28px;
    height: 28px;
    border-radius: 6px;
  }
  .kicker-name {
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: var(--tracking-wordmark);
  }
  .hero h1 {
    margin-top: var(--s6);
    font-size: var(--text-hero);
  }
  .hero h1 .beat {
    display: block;
  }
  .hero .lead {
    margin-top: var(--s5);
  }
  .byline {
    margin-top: var(--s4);
    max-width: var(--measure);
  }
  /* CallActions renders .actions, so reach into it with :global. */
  .hero :global(.actions) {
    margin-top: var(--s6);
  }
  .stories {
    list-style: none;
    padding: 0;
    margin: var(--s6) 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s8);
  }
  .stories p {
    margin-top: var(--s2) !important;
  }
  @media (max-width: 900px) {
    .stories {
      grid-template-columns: 1fr;
      gap: var(--s5);
    }
  }
  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr;
      padding-top: var(--s4);
      row-gap: var(--s10);
    }
    .hero h1 {
      margin-top: var(--s4);
      font-size: var(--text-hero-phone);
    }
    .hero .lead {
      margin-top: var(--s4);
      font-size: var(--text-base);
    }
    .byline {
      margin-top: var(--s3);
    }
    .hero :global(.actions) {
      margin-top: var(--s5);
    }
  }
</style>
