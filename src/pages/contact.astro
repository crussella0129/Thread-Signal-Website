---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Brand from "../components/Brand.astro";
import BrandText from "../components/BrandText.astro";
import HeadlineMotion from "../components/HeadlineMotion.astro";
import CallActions from "../components/CallActions.astro";
import jetsonCad from "../assets/cad/jetson-v3.1a-cad.png";
import jetsonPhoto from "../assets/cad/jetson-v3.1a-photo.webp";
import {
  OWNER_NAME,
  OWNER_TITLE,
  DARIAN_NAME,
  DARIAN_TITLE,
  CONTACT_BRIEF_URL,
  LINKEDIN_URL,
  DARIAN_LINKEDIN_URL,
  GITHUB_URL,
} from "../data/site";
// A hyphenated word in a role line ("Co-owner") moves to the next line whole, like every
// compound on the site (.nobr).
const keepWhole = (title: string) => title.split(/(\S+-\S+)/);
---

<BaseLayout
  title="About & Contact"
  description="Thread & Signal is Charles and Darian Russella in Kent, Ohio. Charles ran his own landscaping and leaf-removal business and is building YardUluv. Call or text (330) 357-2440."
>
  <div class="container page">
    <header class="page-intro">
      <p class="eyebrow">About &amp; Contact</p>
      <h1>
        <HeadlineMotion effect="rise" lines={["Who you’ll be", "talking to."]} />
      </h1>
      <p class="lead">
        Thread &amp; Signal LLC is Charles and Darian Russella, a
        <span class="nobr">husband-and-wife</span> company in Kent, Ohio. Charles
        is building <Brand />, and he’s the one you’ll talk to.
      </p>
    </header>
    <section
      id="contact"
      class="section contact-first"
      aria-labelledby="contact-heading"
    >
      <h2 id="contact-heading">Call or text Charles</h2>
      <p>
        (330) 357-2440 is Charles’s business line. If he misses you, leave a
        message or send a text and he’ll get back to you.
      </p>
      <CallActions />
      <a class="text-link" href={CONTACT_BRIEF_URL}
        >Email Charles and Darian <span aria-hidden="true">→</span></a
      >
      <p class="small">
        Email goes to both of us. Please leave customer names, addresses and
        passwords out of a first message.
      </p>
    </section>
    <div class="people section">
      <section aria-labelledby="charles">
        <h2 id="charles">{OWNER_NAME}</h2>
        <p class="role">
          {
            keepWhole(OWNER_TITLE).map((part, i) =>
              i % 2 ? (
                <span class="nobr">{part}</span>
              ) : (
                <BrandText text={part} />
              ),
            )
          }
        </p>
        <p>
          Charles ran his own landscaping and
          <span class="nobr">leaf-removal</span> business and has worked a
          landscaping job for another company.
        </p>
        <p>
          He also spent seven years in sales, mortgage lending, and
          <span class="nobr">financial-crimes</span> compliance. He’s building
          <Brand /> around the moment that decides whether a job makes money: the
          quote the customer signs.
        </p>
        <p>
          He plans to set up the first <span class="nowrap">100 <Brand /></span>
          customers himself, in
          person.
        </p>
        <a class="text-link" href={LINKEDIN_URL}
          >Charles on LinkedIn <span aria-hidden="true">↗&#xFE0E;</span></a
        >
      </section>
      <section aria-labelledby="darian">
        <h2 id="darian">{DARIAN_NAME}</h2>
        <p class="role">
          {
            keepWhole(DARIAN_TITLE).map((part, i) =>
              i % 2 ? <span class="nobr">{part}</span> : part,
            )
          }
        </p>
        <p>
          Darian has a master’s in Engineering Management Technology and a
          background in live broadcast systems. She brings systems design,
          troubleshooting, and clear technical documentation to Thread &amp;
          Signal.
        </p>
        <p>
          Darian also shaped the marketing side of Thread &amp; Signal and helps
          work out the strategy behind much of what we build, while Charles
          builds the software and the SI tools.
        </p>
        <a class="text-link" href={DARIAN_LINKEDIN_URL}
          >Darian on LinkedIn <span aria-hidden="true">↗&#xFE0E;</span></a
        >
      </section>
    </div>
    <section class="section made" aria-labelledby="made-heading">
      <h2 id="made-heading">Designed on screen, built for real</h2>
      <p>
        Charles also designs parts in CAD and <span class="nobr">3D-prints</span>
        them. This case for an Nvidia Jetson computer went from a model on the
        screen to a part in the hand. <Brand /> is built the same way: a model on
        the screen of a yard you can walk.
      </p>
      <figure>
        <div class="made-images">
          <div class="media-frame made-cad">
            <Image
              src={jetsonCad}
              alt="CAD design of our Jetson case, showing the fan opening, buttons, and computer ports."
              widths={[480, 800, 1200]}
              sizes="(max-width: 640px) 100vw, 36rem"
              format="webp"
              loading="lazy"
            />
          </div>
          <div class="media-frame">
            <Image
              src={jetsonPhoto}
              alt="The finished 3D-printed Jetson case held in one hand, with the fan and computer ports visible."
              widths={[480, 800, 1200]}
              sizes="(max-width: 640px) 100vw, 36rem"
              format="webp"
              loading="lazy"
            />
          </div>
        </div>
        <figcaption>
          The same case, as a CAD model and as a 3D print. The design is open
          source:
          <a href={`${GITHUB_URL}/Jetson-Orin-Nano-Super-Case`}
            >Nvidia Jetson Orin Nano Super Case v3.1a</a
          >
        </figcaption>
      </figure>
    </section>
    <section class="section" aria-labelledby="area-heading">
      <h2 id="area-heading">Where we work</h2>
      <p>
        We’re based in Kent, Ohio. Charles comes to you anywhere in Northeast
        Ohio: Akron, Cleveland, Canton, Youngstown and the towns between.
      </p>
    </section>
    <section class="section other-work" aria-labelledby="other-heading">
      <h2 id="other-heading" class="h3">Other work</h2>
      <p class="small">
        Thread &amp; Signal also sets up local Super Intelligence (SI) systems
        for businesses near Kent. Ask Charles.
      </p>
    </section>
  </div>
</BaseLayout>
<style>
  .people {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s12);
  }
  .people > section > p {
    color: var(--muted);
    max-width: var(--measure);
    margin-top: var(--s3);
  }
  /* Scoping raises the rule above's specificity, so name the role the same way. */
  .people > section > .role {
    margin-top: var(--s2);
  }
  .contact-first .text-link {
    margin-top: var(--s3);
  }
  .people section {
    border-top: 0;
    padding-top: 0;
  }
  .made > p {
    color: var(--muted);
    max-width: var(--measure);
    margin-top: var(--s3);
  }
  .made figure {
    margin-top: var(--s8);
  }
  .made-images {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s4);
  }
  .made-images img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 50% 58%;
  }
  /* The CAD render in black and white, like the rest of the site; the print keeps its colour. */
  .made-cad img {
    object-position: center;
    filter: grayscale(1);
  }
  .made figcaption {
    margin-top: var(--s4);
  }
  @media (max-width: 640px) {
    .made-images {
      grid-template-columns: minmax(0, 1fr);
    }
    .people {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s8);
    }
  }
</style>
