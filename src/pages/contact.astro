---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeadlineMotion from "../components/HeadlineMotion.astro";
import {
  OWNER_NAME,
  OWNER_TITLE,
  DARIAN_NAME,
  DARIAN_TITLE,
  AUTOMATION_BRIEF_URL,
  LINKEDIN_URL,
  DARIAN_LINKEDIN_URL,
} from "../data/site";
---

<BaseLayout
  title="About Us & Contact"
  description="Meet Charles and Darian Russella, the owners of Thread & Signal in Kent, Ohio. Tell us about the business task you would like to make easier."
>
  <div class="container page">
    <header class="page-intro">
      <p class="eyebrow">About Us & Contact</p>
      <h1>
        <HeadlineMotion
          effect="rise"
          lines={["Two people.", "Practical help."]}
        />
      </h1>
      <p class="lead">
        We’re Charles and Darian Russella, a husband-and-wife team in Kent,
        Ohio. We bring business experience and systems engineering to the work
        you want to make easier.
      </p>
    </header>
    <div class="people">
      <section aria-labelledby="charles">
        <h2 id="charles">{OWNER_NAME}</h2>
        <p class="role">{OWNER_TITLE}</p>
        <p>
          Charles spent seven years in sales, mortgage lending, and
          financial-crimes compliance. He started automating the Excel and
          Microsoft 365 tasks he did every day. Now he builds business tools and
          local AI systems.
        </p>
        <a class="text-link" href={LINKEDIN_URL}
          >Charles on LinkedIn <span aria-hidden="true">↗</span></a
        >
      </section>
      <section aria-labelledby="darian">
        <h2 id="darian">{DARIAN_NAME}</h2>
        <p class="role">{DARIAN_TITLE}</p>
        <p>
          Darian has a master’s in Engineering Management Technology and a
          background in live broadcast systems. She brings systems design,
          troubleshooting, and clear technical documentation to our work, and
          can assist with contract remote broadcast projects.
        </p>
        <a class="text-link" href={DARIAN_LINKEDIN_URL}
          >Darian on LinkedIn <span aria-hidden="true">↗</span></a
        >
      </section>
    </div>
    <section class="contact" aria-labelledby="contact-heading">
      <div>
        <h2 id="contact-heading">What takes too long?</h2><p>
          Tell us what you do now and what you’d like to change. Plain language
          is perfect.
        </p>
      </div>
      <div class="contact-actions">
        <a class="action" href={AUTOMATION_BRIEF_URL}>Email us about a task</a>
        <p>
          Please leave passwords and sensitive customer data out of your first
          message.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>
<style>
  .people {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s12);
  }
  .people section {
    border-top: var(--stroke) solid var(--rule);
    padding-top: var(--s8);
  }
  .role {
    color: var(--muted);
    margin-top: var(--s2);
    margin-bottom: var(--s5);
  }
  .people section > p:last-of-type {
    color: var(--muted);
    max-width: var(--measure);
  }
  .people .text-link {
    margin-top: var(--s4);
  }
  .contact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s12);
    border-top: var(--stroke) solid var(--rule);
    padding-top: var(--s8);
    margin-top: var(--section-gap);
  }
  .contact p {
    color: var(--muted);
    margin-top: var(--s4);
    max-width: var(--measure);
  }
  .contact-actions {
    align-self: center;
  }
  @media (max-width: 640px) {
    .people,
    .contact {
      grid-template-columns: 1fr;
      gap: var(--s8);
    }
  }
</style>
