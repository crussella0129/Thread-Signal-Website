---
import BaseLayout from '../layouts/BaseLayout.astro';
import { EMAIL, GITHUB_URL, LINKEDIN_URL, OWNER_NAME, OWNER_LOCATION, AUTOMATION_BRIEF_URL } from '../data/site';

const description = `Discuss an automation, local AI deployment, workshop, or CAD commission directly with ${OWNER_NAME}. Start with a short project brief by email.`;
---

<BaseLayout title="Contact Charles Russella — Discuss a Project" description={description}>
  <!-- Hero: a telegraph wire carrying morse -->
  <section class="contact-hero">
    <canvas id="wire" aria-hidden="true"></canvas>
    <div class="container contact-hero-content">
      <p class="eyebrow">The first thread</p>
      <h1><span class="ink-gradient">The line is open.</span></h1>
      <p class="lead">
        Write directly to {OWNER_NAME}, the developer and designer behind
        Thread &amp; Signal in {OWNER_LOCATION}. An automation to build, local AI
        to evaluate, a design to commission, a skill to learn — it starts here.
      </p>
      <p class="tx-note">TX &mdash; &ldquo;HELLO&rdquo; &middot; MORSE, ON THE WIRE</p>
    </div>
  </section>

  <div class="geo-divider"></div>

  <section class="section container editorial-split">
    <div>
      <p class="eyebrow">Write the first line</p>
      <h2 class="section-title editorial-heading">Bring the problem.<br />We'll find the scope.</h2>
    </div>
    <div class="prose-stack">
      <p>For automation and local AI projects, these details help me understand what a useful first commission would look like:</p>
      <ol class="brief-list">
        <li><strong>The workflow:</strong> what happens today, which tools you use, and what is repetitive or difficult.</li>
        <li><strong>The result:</strong> an example input and output, plus any step that needs a person's approval.</li>
        <li><strong>The environment:</strong> available hardware, where data can be processed, and timing or budget if known.</li>
      </ol>
      <div class="action-row">
        <a href={AUTOMATION_BRIEF_URL} class="btn btn-primary">Scope an automation</a>
      </div>
      <p class="section-note">
        Opens an editable draft in your email app. You can also write to
        <a href={`mailto:${EMAIL}`} class="text-link">{EMAIL}</a> in your own words.
        For a workshop or design, a sentence about the team or part is plenty.
      </p>
      <p>I'll follow up to clarify fit and propose a scope. Price, timing, and deliverables are agreed in writing before work begins.</p>
    </div>
  </section>

  <div class="geo-divider"></div>

  <!-- Channels -->
  <section class="section container">
    <h2 class="section-title">Direct lines to the workshop.</h2>
    <div class="channels reveal-stagger">
      <a class="card card-copper channel contact-primary" href={`mailto:${EMAIL}`}>
        <svg class="channel-icon" viewBox="0 0 40 40" aria-hidden="true">
          <rect x="5" y="10" width="30" height="20" rx="2" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M5 12 L20 23 L35 12" fill="none" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <p class="channel-tag">Email &mdash; fastest response</p>
        <h3>{EMAIL}</h3>
        <p class="channel-note">
          Straight to my inbox, answered personally — usually within a business
          day. A sentence and a sketch of the problem is plenty to start.
        </p>
        <span class="channel-link">Write the first line &rarr;</span>
      </a>

      <a class="card card-thread channel" href={GITHUB_URL} target="_blank" rel="noopener">
        <svg class="channel-icon" viewBox="0 0 40 40" aria-hidden="true">
          <circle cx="12" cy="10" r="3.5" fill="none" stroke="currentColor" stroke-width="1.4" />
          <circle cx="12" cy="30" r="3.5" fill="none" stroke="currentColor" stroke-width="1.4" />
          <circle cx="28" cy="14" r="3.5" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M12 13.5 V26.5 M28 17.5 C28 24, 16 22, 12.5 27" fill="none" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <p class="channel-tag">GitHub</p>
        <h3>crussella0129</h3>
        <p class="channel-note">
          Read the code before you write the email — every project on the shelf
          is public. Issues and pull requests are conversations too.
        </p>
        <span class="channel-link">Browse the shelf &rarr;</span>
      </a>

      <a class="card card-madder channel" href={LINKEDIN_URL} target="_blank" rel="noopener">
        <svg class="channel-icon" viewBox="0 0 40 40" aria-hidden="true">
          <rect x="6" y="6" width="28" height="28" rx="4" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M13 17 V28 M13 12.5 V13 M19 28 V21 C19 17.5, 27 17.5, 27 21 V28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
        <p class="channel-tag">LinkedIn</p>
        <h3>in/cgriv</h3>
        <p class="channel-note">
          The professional thread — background, history, and the longer story
          behind the workshop.
        </p>
        <span class="channel-link">Connect the thread &rarr;</span>
      </a>
    </div>

    <p class="channels-note reveal">
      Prefer paper trails? Everything discussed by email — scope, price,
      delivery — is the record. No portals, no logins, nothing to lose.
    </p>
  </section>
</BaseLayout>

<style>
  .contact-hero {
    position: relative;
    min-height: 58vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  #wire {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .contact-hero-content {
    position: relative;
    z-index: 1;
    max-width: 820px;
    padding-top: 3rem;
    padding-bottom: 3rem;
  }

  .lead {
    color: var(--text-muted);
    font-size: 1.15rem;
    line-height: 1.7;
    margin: 1.5rem 0 1.75rem;
    max-width: 640px;
  }

  .tx-note {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    color: var(--accent);
    opacity: 0.75;
  }

  .channels {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 270px), 1fr));
    gap: 1.5rem;
    margin-top: var(--space-xl);
  }

  .channel {
    display: flex;
    flex-direction: column;
    color: var(--text);
  }

  .channel:hover {
    color: var(--text);
  }

  /* Copper treatment for the primary channel. */
  .contact-primary {
    border-color: rgba(232, 163, 61, 0.3);
    box-shadow: 0 0 22px var(--accent-glow);
  }

  .channel-icon {
    width: 40px;
    height: 40px;
    color: var(--lane);
    margin-bottom: 1.1rem;
  }

  .channel-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }

  .channel h3 {
    font-size: 1.15rem;
    margin-bottom: 0.7rem;
    word-break: break-all;
  }

  .channel-note {
    color: var(--text-muted);
    font-size: 0.93rem;
    line-height: 1.65;
    margin-bottom: 1.2rem;
    flex-grow: 1;
  }

  .channel-link {
    color: var(--lane);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .channels-note {
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 450;
    color: var(--text-muted);
    text-align: center;
    margin-top: 2.5rem;
  }
</style>

<script is:inline>
  (function () {
    var canvas = document.getElementById('wire');
    if (!canvas || !canvas.getContext) return;
    var ctx = canvas.getContext('2d');
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    var GOLD = '232,163,61';
    var W = 0, H = 0, dpr = 1, wireY = 0;

    // "HELLO" in morse: dot=1 unit, dash=3, gaps 1/3, word wrap gap 12.
    var MORSE = { H: '....', E: '.', L: '.-..', O: '---' };
    var UNIT = 11;
    var segs = [];
    var word = 'HELLO';
    for (var i = 0; i < word.length; i++) {
      var code = MORSE[word[i]];
      for (var j = 0; j < code.length; j++) {
        segs.push({ on: true, units: code[j] === '.' ? 1 : 3 });
        if (j < code.length - 1) segs.push({ on: false, units: 1 });
      }
      if (i < word.length - 1) segs.push({ on: false, units: 3 });
    }
    segs.push({ on: false, units: 12 });
    var totalPx = segs.reduce(function (n, s) { return n + s.units; }, 0) * UNIT;

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 1.75);
      W = canvas.clientWidth;
      H = canvas.clientHeight;
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      wireY = H * 0.72;
    }

    function drawWires() {
      ctx.clearRect(0, 0, W, H);
      [wireY - 46, wireY + 46].forEach(function (y) {
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(W, y);
        ctx.strokeStyle = 'rgba(236,229,216,0.05)';
        ctx.lineWidth = 1;
        ctx.stroke();
      });
      ctx.beginPath();
      ctx.moveTo(0, wireY);
      ctx.lineTo(W, wireY);
      ctx.strokeStyle = 'rgba(79,184,168,0.16)';
      ctx.lineWidth = 1;
      ctx.stroke();
    }

    // Draw one copy of the message train starting at x0.
    function drawMessage(x0) {
      var x = x0;
      for (var k = 0; k < segs.length; k++) {
        var len = segs[k].units * UNIT;
        if (segs[k].on && x + len > 0 && x < W) {
          ctx.beginPath();
          ctx.moveTo(Math.max(0, x) + 1.5, wireY);
          ctx.lineTo(Math.min(W, x + len) - 1.5, wireY);
          ctx.strokeStyle = 'rgba(' + GOLD + ',0.9)';
          ctx.lineWidth = 2.5;
          ctx.lineCap = 'round';
          ctx.shadowColor = 'rgba(' + GOLD + ',0.7)';
          ctx.shadowBlur = 9;
          ctx.stroke();
          ctx.shadowBlur = 0;
        }
        x += len;
      }
    }

    var SPEED = 65; // px per second — telegraph pace

    function frame(now) {
      drawWires();
      var offset = ((now / 1000) * SPEED) % totalPx;
      for (var base = -totalPx + offset; base < W; base += totalPx) {
        drawMessage(base);
      }
      requestAnimationFrame(frame);
    }

    resize();
    window.addEventListener('resize', resize);

    if (reduced) {
      drawWires();
      drawMessage(Math.max(20, (W - totalPx) / 2));
    } else {
      requestAnimationFrame(frame);
    }
  })();
</script>
