---
import BaseLayout from '../layouts/BaseLayout.astro';
import { EMAIL, GITHUB_URL, LINKEDIN_URL, FORMSPREE_ENDPOINT } from '../data/site';
---

<BaseLayout title="Contact" description="Book a consult with Thread & Signal — business process automation, custom agent harnesses, agent skills and workshops, CAD and 3D printing design and lessons.">
  <section class="section container contact-page">
    <div class="contact-content">
      <p class="eyebrow">The first thread</p>
      <h1 class="section-title">Bring us the work.</h1>
      <p class="section-subtitle">
        An automation to build, a harness to deploy, a design to commission,
        a skill to learn — every commission starts with a conversation.
        Tell me what you're working on.
      </p>

      <div class="contact-info">
        <div class="contact-item contact-primary">
          <h3>Email — fastest response</h3>
          <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
        </div>
        <div class="contact-item">
          <h3>GitHub</h3>
          <a href={GITHUB_URL} target="_blank" rel="noopener">github.com/crussella0129</a>
        </div>
        <div class="contact-item">
          <h3>LinkedIn</h3>
          <a href={LINKEDIN_URL} target="_blank" rel="noopener">linkedin.com/in/cgriv</a>
        </div>
      </div>
    </div>

    <form class="card contact-form" action={FORMSPREE_ENDPOINT} method="POST">
      <div class="form-group">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" required placeholder="Your name" />
      </div>
      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required placeholder="you@example.com" />
      </div>
      <div class="form-group">
        <label for="subject">What are you looking for?</label>
        <select id="subject" name="subject" required>
          <option value="" disabled selected>Select a service</option>
          <option value="automation">Business Process Automation</option>
          <option value="animus">Animus / Custom Harness Implementation</option>
          <option value="skills">Agent Skills &amp; Workshops</option>
          <option value="design">CAD / 3D Design Commission</option>
          <option value="lessons">CAD &amp; 3D Printing Lessons</option>
          <option value="other">Something Else</option>
        </select>
      </div>
      <div class="form-group">
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="5" required placeholder="Tell me about your project..."></textarea>
      </div>
      <button type="submit" class="btn btn-primary" style="width: 100%;">Send Message</button>
      <p class="form-note">Prefer email? Writing directly to <a href={`mailto:${EMAIL}`}>{EMAIL}</a> gets the fastest response.</p>
    </form>
  </section>
</BaseLayout>

<style>
  .contact-page {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .contact-info {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .contact-item h3 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin-bottom: 0.35rem;
  }

  .contact-item a {
    font-size: 1rem;
  }

  .contact-primary {
    padding: 1rem 1.25rem;
    border: 1px solid rgba(232, 163, 61, 0.3);
    border-radius: 10px;
    background: var(--accent-glow);
    box-shadow: 0 0 22px var(--accent-glow);
  }

  .contact-primary a {
    font-size: 1.15rem;
    font-weight: 600;
  }

  .form-note {
    color: var(--text-muted);
    font-size: 0.85rem;
    text-align: center;
    margin-top: 0.25rem;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-group label {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    color: var(--text);
    font-family: var(--font-body);
    font-size: 0.95rem;
    transition: border-color var(--transition);
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-glow);
  }

  .form-group select {
    cursor: pointer;
  }

  .form-group textarea {
    resize: vertical;
    min-height: 120px;
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: var(--text-muted);
    opacity: 0.5;
  }

  @media (max-width: 768px) {
    .contact-page {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
