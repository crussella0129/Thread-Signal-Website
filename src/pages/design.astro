---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_URL, EMAIL } from '../data/site';

const description =
  'CAD design commissions and 1-on-1 Autodesk Fusion lessons from Thread & Signal. 3D-printable designs for commercial, enthusiast, and academic customers — jigs and fixtures, corporate gear, gaming assets, and manufacturing equipment.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'CAD Design Commissions & 3D Printing Lessons',
  serviceType: 'CAD design and training',
  description:
    'Commissioned CAD/3D-printing design work (jigs & fixtures, corporate branded gear, gaming assets, manufacturing equipment) and 1-on-1 Autodesk Fusion courses in geometry and additive manufacturing.',
  provider: { '@type': 'Organization', name: 'Thread & Signal', url: SITE_URL },
  url: `${SITE_URL}/design`,
};
---

<BaseLayout title="CAD & 3D Design — Drawn, Printed, Held" description={description} jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="section container design-hero">
    <p class="eyebrow eyebrow-madder">Design &amp; fabrication</p>
    <h1><span class="ink-madder">Drawn, printed, held.</span></h1>
    <p class="lead">
      Parametric CAD design with manufacturing in mind — and lessons that get you
      designing your own parts, not just watching someone else do it. Work
      delivered for <strong>commercial, enthusiast, and academic</strong>
      customers alike.
    </p>
    <div class="hero-cta">
      <a href="/contact" class="btn btn-primary">Commission a Design</a>
      <a href="#lessons" class="btn btn-outline">Book Lessons</a>
    </div>
  </section>

  <div class="geo-divider"></div>

  <!-- Proof -->
  <section class="section container">
    <p class="eyebrow eyebrow-madder">The shelf</p>
    <h2 class="section-title">Proof in the printing.</h2>
    <p class="section-subtitle">
      Open-source designs you can print today — the same rigor goes into every
      commission.
    </p>

    <div class="proof-grid reveal-stagger">
      <div class="card card-madder proof-item proof-flagship">
        <h3><a href="https://github.com/crussella0129/Jetson-Orin-Nano-Super-Case" target="_blank" rel="noopener">Jetson Orin Nano Super Case</a></h3>
        <p>
          An open-source desktop case for Nvidia's Jetson Orin Nano Super
          Developer Kit — the catalog's flagship with 35+ stars. Where edge AI
          meets the print bed: designed, printed, and in daily use hosting local
          models.
        </p>
        <span class="proof-tags">3D Printing · Nvidia Jetson · Edge AI</span>
      </div>
      <div class="card card-madder proof-item">
        <h3><a href="https://github.com/crussella0129/HexQuest" target="_blank" rel="noopener">HexQuest</a></h3>
        <p>
          A parametric 40×40 hex game-board piece generator — tabletop gaming
          assets you customize in CAD and print at home.
        </p>
        <span class="proof-tags">Parametric CAD · Gaming</span>
      </div>
      <div class="card card-madder proof-item">
        <h3><a href="https://github.com/crussella0129/PreHeat-Macros" target="_blank" rel="noopener">PreHeat Macros</a></h3>
        <p>
          Material-specific preheat macros with automatic chamber soak for
          Klipper printers — the workflow side of reliable printing.
        </p>
        <span class="proof-tags">Klipper · Print Workflow</span>
      </div>
    </div>
  </section>

  <div class="geo-divider"></div>

  <!-- Offers -->
  <section class="section container">
    <p class="eyebrow eyebrow-madder">The commission</p>
    <h2 class="section-title">Commissions &amp; courses.</h2>

    <div class="offer-grid reveal-stagger">
      <div class="card card-madder offer">
        <p class="numeral numeral-madder">01</p>
        <h3>Commissioned Design Work</h3>
        <p>
          Custom CAD designs delivered as print-ready or machine-ready files:
        </p>
        <ul>
          <li>Jigs &amp; fixtures for assembly and manufacturing workflows</li>
          <li>AI-powered manufacturing equipment enclosures and hardware</li>
          <li>Corporate branded gear and promotional pieces</li>
          <li>Gaming assets and enthusiast projects</li>
        </ul>
        <a href="/contact" class="btn btn-primary">Commission a Design</a>
      </div>
      <div id="lessons" class="card card-madder offer">
        <p class="numeral numeral-madder">02</p>
        <h3>1-on-1 CAD &amp; 3D Printing Lessons</h3>
        <p>
          Private courses in <strong>Autodesk Fusion</strong>, tailored to where
          you are:
        </p>
        <ul>
          <li>Geometry foundations — sketches, constraints, parametric thinking</li>
          <li>Additive manufacturing — designing for the printer you own</li>
          <li>From idea to artifact: your own project, guided end to end</li>
        </ul>
        <a href="/contact" class="btn btn-primary">Book a Lesson</a>
      </div>
    </div>

    <div class="cta-block">
      <p class="cta-note">Not sure which you need? Email <a href={`mailto:${EMAIL}`}>{EMAIL}</a> — a photo and a sentence is enough to start.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .design-hero {
    position: relative;
    padding-top: 5rem;
    max-width: 860px;
  }

  /* Isometric wireframe motif. */
  .design-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(30deg, rgba(194, 84, 63, 0.05) 0 1px, transparent 1px 44px),
      repeating-linear-gradient(-30deg, rgba(194, 84, 63, 0.05) 0 1px, transparent 1px 44px);
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.65), transparent 85%);
    pointer-events: none;
  }

  .eyebrow-madder {
    color: var(--accent-warm);
  }

  .eyebrow-madder::before {
    background: linear-gradient(90deg, var(--accent-warm), transparent);
  }

  .numeral-madder {
    color: var(--accent-warm);
  }

  .lead {
    color: var(--text-muted);
    font-size: 1.15rem;
    line-height: 1.7;
    margin: 1.5rem 0 2rem;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .proof-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }

  .proof-item h3 {
    font-size: 1.1rem;
    margin-bottom: 0.75rem;
  }

  .proof-item h3 a {
    color: var(--text);
  }

  .proof-item h3 a:hover {
    color: var(--accent-warm);
  }

  .proof-item p {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.65;
    margin-bottom: 1rem;
  }

  .proof-flagship {
    box-shadow: 0 0 26px var(--accent-warm-glow);
  }

  .proof-tags {
    font-family: var(--font-mono);
    font-size: 0.73rem;
    color: var(--accent-warm);
  }

  .offer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .offer .numeral {
    margin-bottom: 0.6rem;
  }

  .offer h3 {
    font-size: 1.15rem;
    margin-bottom: 0.75rem;
  }

  .offer p {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .offer ul {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.8;
    margin: 0.75rem 0 1.5rem 1.25rem;
  }

  .cta-block {
    text-align: center;
    margin-top: 2.5rem;
  }

  .cta-note {
    color: var(--text-muted);
    font-size: 0.9rem;
  }
</style>
