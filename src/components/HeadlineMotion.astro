---
/*
 * Page headline entrances. Pure CSS: the site ships no JavaScript, so the
 * letters and lines are split here at build time. Each effect plays once on
 * load and is skipped entirely for visitors who prefer reduced motion.
 *
 *   print   (unused) each letter strikes as a solid block, then becomes the letter.
 *   read    (unused) a 1px read head sweeps across, revealing the text behind it.
 *   thread  Open-Source: a 1px thread draws under the words, which lift onto it,
 *           then its tail pulls through and out, leaving no underline.
 *   rise    How It Works, Founders Club, About: each line slides up from behind
 *           its own edge, in turn. A non-breaking space (U+00A0) in a rise line keeps
 *           the words around it together: "The Founders\u00a0Club." moves "Founders
 *           Club." to the next line whole, and it still wraps at that space when it
 *           cannot fit a line by itself (large text on a narrow phone).
 */
interface Props {
  effect: "print" | "read" | "thread" | "rise";
  lines: string[];
}
const { effect, lines } = Astro.props;
let index = 0;
const letters = lines.map((line) =>
  [...line].map((char) => ({ char, index: index++ })),
);
const last = lines.length - 1;
// Odd entries are the phrases joined by U+00A0, rendered as one .nobr unit with plain spaces.
const groups = (line: string) => line.split(/(\S+(?:\u00a0\S+)+)/);
---

<span class={`fx fx-${effect}`}>
  {
    effect === "print" &&
      letters.map((line, n) => (
        <>
          {n > 0 && <br />}
          {line.map(({ char, index }) => (
            <span class="ch" style={`--i:${index}`} set:text={char} />
          ))}
        </>
      ))
  }
  {
    effect === "read" && (
      <>
        <span class="fx-text">
          {lines.map((line, n) => (
            <>
              {n > 0 && <br />}
              {line}
            </>
          ))}
        </span>
        <span class="head" aria-hidden="true" />
      </>
    )
  }
  {
    effect === "thread" &&
      lines.map((line, n) =>
        n === last ? (
          <span class="threaded">
            <span class="words" set:text={line} />
          </span>
        ) : (
          <>
            {line}
            <br />
          </>
        ),
      )
  }
  {
    effect === "rise" &&
      lines.map((line, n) => (
        <span class="mask">
          <span class="line" style={`--l:${n}`}>
            {groups(line).map((part, i) =>
              i % 2 ? (
                <span class="nobr" set:text={part.replaceAll("\u00a0", " ")} />
              ) : (
                part
              ),
            )}
          </span>
        </span>
      ))
  }
</span>

<style>
  /* Print */
  /* Fill backwards only. After the strike each letter falls back to its own
     style (white text), which matches the final keyframe. WebKit ends some
     staggered animations a hair short of 100%, and with steps() and a forward
     fill that froze letters on the 55% keyframe as solid blocks. */
  .fx-print .ch {
    animation: print var(--duration-print) steps(1, end) backwards;
    animation-delay: calc(var(--i) * var(--stagger-letter));
  }
  /* #fff is --text written out: the site check keeps var() out of keyframes. */
  @keyframes print {
    0% {
      opacity: 0;
    }
    1% {
      opacity: 1;
      color: transparent;
      background: #fff;
    }
    55% {
      color: transparent;
      background: #fff;
    }
    100% {
      opacity: 1;
      color: #fff;
      background: transparent;
    }
  }

  /* Read head */
  .fx-read {
    position: relative;
    display: inline-block;
  }
  .fx-read .fx-text {
    display: block;
    animation: reveal var(--duration-sweep) var(--ease-sweep) both;
  }
  .fx-read .head {
    position: absolute;
    inset: -0.1em 0;
    border-right: var(--stroke) solid var(--text);
    opacity: 0;
    pointer-events: none;
    animation:
      sweep var(--duration-sweep) var(--ease-sweep) both,
      fade-out var(--duration-fade) ease-out var(--duration-sweep) forwards;
  }
  @keyframes reveal {
    from {
      clip-path: inset(-0.2em 100% -0.2em 0);
    }
    to {
      clip-path: inset(-0.2em 0 -0.2em 0);
    }
  }
  @keyframes sweep {
    from {
      transform: translateX(-100%);
      opacity: 1;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }
  @keyframes fade-out {
    to {
      opacity: 0;
    }
  }

  /* Thread, pulled through. Fill backwards only, as for rise: each end keyframe equals the
     element's own style (the ::after's clip-path, the words' opacity 1 and no transform). */
  .fx-thread .threaded {
    position: relative;
    display: inline-block;
  }
  .fx-thread .threaded::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(var(--s3) * -1);
    height: var(--stroke);
    background: var(--text);
    clip-path: inset(0 0 0 100%);
    animation: thread-pull var(--duration-thread) var(--ease-out) backwards;
  }
  .fx-thread .words {
    display: inline-block;
    animation: lift var(--duration-lift) var(--ease-out)
      calc(var(--duration-thread) * 0.22) backwards;
  }
  @keyframes thread-pull {
    0% {
      clip-path: inset(0 100% 0 0);
    }
    45% {
      clip-path: inset(0 0 0 0);
    }
    65% {
      clip-path: inset(0 0 0 0);
      /* --ease-sweep, written out: var() is ignored as a keyframe easing. */
      animation-timing-function: cubic-bezier(0.45, 0, 0.2, 1);
    }
    100% {
      clip-path: inset(0 0 0 100%);
    }
  }
  @keyframes lift {
    from {
      opacity: 0.02;
      transform: translateY(0.35em);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Line rise */
  /* The padding and negative margin keep the line box where it was and move the clip edge out:
     0.12em down for descenders, 0.02em right for a phrase's slack (below). */
  .fx-rise .mask {
    display: block;
    overflow: hidden;
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
    padding-inline-end: 0.02em;
    margin-inline-end: -0.02em;
  }
  /* Fill backwards only: the end keyframe equals the base style. A word wider than the line
     (large text on a narrow phone) wraps instead of being cut off by the mask: "anywhere",
     not "break-word", so a .nobr phrase can shrink to the line too. */
  .fx-rise .line {
    display: block;
    overflow-wrap: anywhere;
    animation: rise var(--duration-rise) var(--ease-out) backwards;
    animation-delay: calc(var(--l) * var(--stagger-line));
  }
  /* A phrase held together with U+00A0 wraps greedily inside itself. Its 0.02em of slack (up to
     the mask's clip edge) keeps a word that overflows the line by a fraction of a pixel whole,
     instead of splitting it ("Founder / s"). */
  .fx-rise .nobr {
    margin-inline-end: -0.02em;
    text-wrap: wrap;
  }
  @keyframes rise {
    from {
      transform: translateY(110%);
    }
    to {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fx *,
    .fx *::after {
      animation: none !important;
    }
    .fx-read .head {
      display: none;
    }
  }
</style>
