---
/*
 * The sample yard (src/data/sample-job.ts) as an angled 3D illustration: an isometric view
 * of a synthetic lot, not a plan, a survey or a capture. Heights and the fall of the front
 * yard are exaggerated, and the figure says "Illustration" on its face and "not to scale" in its <desc>.
 *   model   Step 1: the property model with two measuring lines (works today).
 *   design  Home figure and step 2: the new bed, edging, shrubs and tags.
 * The tag text is literal: if a quantity in sample-job.ts changes, change it here too.
 * Coordinates come from the isometric generator (both ground axes at 30 degrees, 0.672 viewBox
 * units per sample-yard unit); move a point only together with everything that touches it.
 * Motion runs only with `animate`, above 760 px, once, and never for reduced motion.
 */
interface Props {
  layer: "model" | "design";
  id: string;
  animate?: boolean;
}
const { layer, id, animate = false } = Astro.props;
const model = layer === "model";
const title = model
  ? "Illustration of a sample yard on the model, measured"
  : "Illustration of a sample front yard, with a new planting bed designed on it";
const desc = model
  ? "Angled 3D illustration, not to scale: the height of the buildings and the slope of the yard are exaggerated for clarity. The same sample property, before any design: the ground, a house with a gable roof and an attached garage at the back of the lot, a driveway down to the street, and one tree in the front yard. The front yard falls gently toward the street, shown by two contour lines and by the edge of the model. One measuring line along the front of the house reads 40 feet. A second line, from a point on the first line down to the street, reads 20 feet at a 4 percent slope."
  : "Angled 3D illustration, not to scale: the height of the buildings and the slope of the yard are exaggerated for clarity. A house and garage sit at the back of the lot, with a driveway down to the street. A new planting bed along the front of the house is outlined in pink with steel edging and six shrubs. Three tags, each joined by a short line to what it measures, read: bed 324 square feet, edging 56 feet, and haul-off 2 loads from a pile of old sod near the street.";
---

