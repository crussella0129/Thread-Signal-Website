<style>
  /*
   * Home figure (G1) only. Same order and timing as the estimate's row flashes
   * (SampleEstimate.astro). The edging's measured getTotalLength() is 192.66 in
   * Chromium and WebKit, so the literal dash is 193, set only inside the keyframes.
   * Fill mode is backwards everywhere: each element's own style is the final frame.
   * Only opacity, translateY and the edging's dash offset animate, and no animated
   * element carries an SVG transform attribute.
   */
  @media (prefers-reduced-motion: no-preference) {
    .yd-animate .yd-pile {
      animation: yd-rise 220ms cubic-bezier(0.2, 0.7, 0.1, 1) 100ms backwards;
    }
    .yd-animate .yd-tag-haul {
      animation: yd-rise 220ms cubic-bezier(0.2, 0.7, 0.1, 1) 200ms backwards;
    }
    .yd-animate .yd-bed {
      animation: yd-fade 250ms cubic-bezier(0.2, 0.7, 0.1, 1) 350ms backwards;
    }
    .yd-animate .yd-b2 {
      animation: yd-fade 220ms cubic-bezier(0.2, 0.7, 0.1, 1) 350ms backwards;
    }
    .yd-animate .yd-edging {
      animation: yd-draw-edging 500ms cubic-bezier(0.45, 0, 0.2, 1) 350ms
        backwards;
    }
    .yd-animate .yd-tag-edging {
      animation: yd-rise 220ms cubic-bezier(0.2, 0.7, 0.1, 1) 800ms backwards;
    }
    .yd-animate .yd-s1 {
      animation: yd-rise 220ms cubic-bezier(0.2, 0.7, 0.1, 1) 900ms backwards;
    }
    .yd-animate .yd-s2 {
      animation: yd-rise 220ms cubic-bezier(0.2, 0.7, 0.1, 1) 950ms backwards;
    }
    .yd-animate .yd-s3 {
      animation: yd-rise 220ms cubic-bezier(0.2, 0.7, 0.1, 1) 1000ms backwards;
    }
    .yd-animate .yd-s4 {
      animation: yd-rise 220ms cubic-bezier(0.2, 0.7, 0.1, 1) 1050ms backwards;
    }
    .yd-animate .yd-s5 {
      animation: yd-rise 220ms cubic-bezier(0.2, 0.7, 0.1, 1) 1100ms backwards;
    }
    .yd-animate .yd-s6 {
      animation: yd-rise 220ms cubic-bezier(0.2, 0.7, 0.1, 1) 1150ms backwards;
    }
    .yd-animate .yd-tag-bed {
      animation: yd-rise 220ms cubic-bezier(0.2, 0.7, 0.1, 1) 1250ms backwards;
    }
  }
  @keyframes yd-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes yd-rise {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes yd-draw-edging {
    from {
      stroke-dasharray: 193 193;
      stroke-dashoffset: 193;
    }
    to {
      stroke-dasharray: 193 193;
      stroke-dashoffset: 0;
    }
  }
  /* Phones: the figure is below the first screen, so it is static there. */
  @media (max-width: 760px) {
    .yd-animate .yd-pile,
    .yd-animate .yd-tag-haul,
    .yd-animate .yd-bed,
    .yd-animate .yd-b2,
    .yd-animate .yd-edging,
    .yd-animate .yd-tag-edging,
    .yd-animate .yd-s1,
    .yd-animate .yd-s2,
    .yd-animate .yd-s3,
    .yd-animate .yd-s4,
    .yd-animate .yd-s5,
    .yd-animate .yd-s6,
    .yd-animate .yd-tag-bed {
      animation: none !important;
    }
  }
</style>
