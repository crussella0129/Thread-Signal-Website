---
import Brand from "./Brand.astro";
import { SITE_NAME, GITHUB_URL, PHONE_DISPLAY, TEL_URL, SMS_URL } from "../data/site";

// Set at build time; the daily scheduled deploy rolls it over each January.
const year = new Date().getFullYear();
// A <footer>, never a <nav>, and no list markup: the site check counts both.
// Open-Source Dev is also in the main nav, which carries aria-current on that page.
---

<footer class="container site-footer">
  <p>
    <Brand /> is in development at <span class="nobr">{SITE_NAME} LLC</span> in
    Kent, Ohio.
  </p>
  <div class="footer-links">
    <a class="text-link" href={TEL_URL}>Call {PHONE_DISPLAY}</a>
    <a class="text-link" href={SMS_URL}>Text Charles</a>
    <a class="text-link" href="/open-source/">Open-Source Dev</a>
    <a class="text-link" href={GITHUB_URL}
      >GitHub <span aria-hidden="true">↗&#xFE0E;</span></a
    >
  </div>
  <p>© {year} {SITE_NAME} LLC · Kent, Ohio</p>
</footer>
<style>
  /* The footer's margin is the only gap after <main>: .page has no bottom padding. */
  .site-footer {
    margin-top: var(--section-gap);
    padding-block: 0 var(--s6);
    color: var(--muted);
    font-size: var(--text-sm);
  }
  /* The rule sits inside the content column, like every section rule. */
  .site-footer::before {
    content: "";
    display: block;
    border-top: var(--stroke) solid var(--rule);
    margin-bottom: var(--s6);
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--s6);
    margin-block: var(--s2);
  }
  .footer-links a {
    color: var(--text);
  }
</style>
