---
import { SITE_NAME, GITHUB_URL, OWNER_LOCATION } from "../data/site";

// Set at build time; the daily scheduled deploy rolls it over each January.
const year = new Date().getFullYear();
---

<footer class="container">
  <div class="footer-line">
    <p>© {year} {SITE_NAME} LLC · {OWNER_LOCATION}</p>
    <a class="text-link" href={GITHUB_URL}
      >GitHub <span aria-hidden="true">↗</span></a
    >
  </div>
</footer>
<style>
  .footer-line {
    border-top: var(--stroke) solid var(--rule);
    padding-block: var(--s5);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s4);
    color: var(--muted);
    font-size: var(--text-sm);
  }
  @media (max-width: 400px) {
    .footer-line {
      flex-wrap: wrap;
    }
  }
</style>
