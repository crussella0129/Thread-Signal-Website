---
// The specimen plate (fig. 01): a square wave and its sine fundamental,
// generated at build time so the geometry is exact.
const P = { x0: 30, x1: 350, mid: 112, amp: 30, periods: 3 };
const per = (P.x1 - P.x0) / P.periods;

let sqPath = `M ${P.x0} ${P.mid - P.amp}`;
for (let i = 0; i < P.periods; i++) {
  const a = P.x0 + i * per;
  sqPath += ` H ${(a + per / 2).toFixed(1)} V ${P.mid + P.amp} H ${(a + per).toFixed(1)} V ${P.mid - P.amp}`;
}

const sinePts = Array.from({ length: 97 }, (_, i) => {
  const x = P.x0 + (i / 96) * (P.x1 - P.x0);
  const y = P.mid - P.amp * 0.9 * Math.sin(2 * Math.PI * P.periods * (i / 96));
  return `${x.toFixed(1)},${y.toFixed(1)}`;
}).join(' ');
---

<section class="hero">
  <canvas id="loom" aria-hidden="true"></canvas>
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="container hero-content">
    <div class="hero-copy">
      <p class="eyebrow">Agentic development studio</p>
      <h1 class="hero-title">
        <span class="ink-gradient">Handwoven</span> automation.
      </h1>
      <p class="hero-sub">
        Custom AI agents and business process automation — woven in Rust and Python,
        running entirely on hardware you own.
      </p>
      <p class="hero-story">
        The first programmable business machine was a loom<br class="story-break" />
        &mdash; let's build yours.
      </p>
      <div class="hero-cta">
        <a href="/contact" class="btn btn-primary">Commission a build</a>
        <a href="/projects" class="btn btn-outline">See the open source</a>
      </div>
    </div>

    <figure class="hero-plate" aria-hidden="true">
      <svg viewBox="0 0 380 236">
        <rect x="1" y="1" width="378" height="234" fill="none" stroke="currentColor" opacity="0.18" />
        <line x1={P.x0} y1={P.mid} x2={P.x1} y2={P.mid} stroke="currentColor" stroke-width="1" opacity="0.14" />

        <polyline points={sinePts} fill="none" class="plate-sine" stroke-width="1.4" />
        <path d={sqPath} fill="none" class="plate-square" stroke-width="1.6" />

        <text x={P.x0} y="28" class="plate-label plate-label-gold">sq — the signal</text>
        <text x={P.x0} y="42" class="plate-label plate-label-thread">sin — the thread</text>

        <line x1={P.x0} y1="196" x2={P.x1} y2="196" stroke="currentColor" stroke-width="1" opacity="0.18" />
        <rect x="186" y="192.5" width="7" height="7" transform="rotate(45 189.5 196)" fill="none" class="plate-node" stroke-width="1" />
        <text x={P.x0} y="216" class="plate-label plate-label-muted">FIG. 01 — THREAD &amp; SIGNAL</text>
        <text x={P.x1} y="216" text-anchor="end" class="plate-label plate-label-muted">EST. ON A LOOM</text>
      </svg>
      <figcaption class="plate-caption">a square wave and its fundamental, traveling in tandem</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(92vh - var(--nav-height));
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  #loom {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: radial-gradient(
      900px 600px at 28% 55%,
      rgba(20, 18, 16, 0.92) 0%,
      rgba(20, 18, 16, 0.55) 55%,
      transparent 100%
    );
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-top: 2rem;
    padding-bottom: 2rem;
  }

  .hero-copy {
    max-width: 760px;
  }

  /* The specimen plate: fills the wide-screen right side with the brand
     dichotomy drawn as a technical figure. Hidden below 1200px. */
  .hero-plate {
    display: none;
  }

  @media (min-width: 1200px) {
    .hero-content {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(340px, 460px);
      gap: 5rem;
      align-items: center;
    }

    .hero-plate {
      display: block;
      margin: 0;
      padding: 1.5rem 1.5rem 1.1rem;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: rgba(28, 25, 23, 0.55);
      backdrop-filter: blur(6px);
      color: var(--text);
    }
  }

  .hero-plate svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .plate-sine {
    stroke: var(--thread);
    opacity: 0.85;
  }

  .plate-square {
    stroke: var(--accent);
    filter: drop-shadow(0 0 6px rgba(232, 163, 61, 0.35));
  }

  .plate-node {
    stroke: var(--accent);
  }

  .plate-label {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.14em;
  }

  .plate-label-gold { fill: var(--accent); }
  .plate-label-thread { fill: var(--thread); }
  .plate-label-muted { fill: var(--text-muted); }

  .plate-caption {
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 450;
    color: var(--text-muted);
    font-size: 0.9rem;
    text-align: center;
    margin-top: 1rem;
  }

  .hero-title {
    margin-bottom: 1.5rem;
  }

  .hero-sub {
    color: var(--text);
    font-size: 1.2rem;
    max-width: 560px;
    margin-bottom: 1.25rem;
    line-height: 1.7;
  }

  .hero-story {
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 450;
    color: var(--text-muted);
    font-size: 1.05rem;
    margin-bottom: 2.5rem;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 82vh;
    }

    .hero-scrim {
      background: radial-gradient(
        140% 90% at 50% 55%,
        rgba(20, 18, 16, 0.9) 0%,
        rgba(20, 18, 16, 0.6) 60%,
        transparent 100%
      );
    }

    .story-break {
      display: none;
    }
  }
</style>

<script is:inline>
  (function () {
    var canvas = document.getElementById('loom');
    if (!canvas || !canvas.getContext) return;
    var ctx = canvas.getContext('2d');
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    var THREADS = 14;
    var GOLD = '232,163,61';
    var threads = [];
    var packets = [];
    var W = 0, H = 0, dpr = 1;

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 1.75);
      W = canvas.clientWidth;
      H = canvas.clientHeight;
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      // Update threads IN PLACE: in-flight packets hold references to these
      // objects, so rebuilding the array on resize would leave packets riding
      // stale, invisible paths (the de-sync bug). Only geometry that depends
      // on the viewport is recomputed; identity and character survive.
      for (var i = 0; i < THREADS; i++) {
        var y = (H * (i + 1)) / (THREADS + 1);
        if (threads[i]) {
          threads[i].y = y;
        } else {
          threads.push({
            y: y,
            amp: 5 + Math.random() * 14,
            wl: 460 + Math.random() * 520,
            phase: Math.random() * Math.PI * 2,
            speed: 0.1 + Math.random() * 0.18, // radians per second
            hue: Math.random() < 0.2 ? 'thread' : 'linen',
          });
        }
      }
    }

    function threadY(t, x, time) {
      return t.y + Math.sin(x / t.wl + t.phase + time * t.speed) * t.amp;
    }

    function drawThread(t, time) {
      ctx.beginPath();
      for (var x = 0; x <= W; x += 14) {
        var y = threadY(t, x, time);
        x === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
      }
      ctx.strokeStyle = t.hue === 'thread' ? 'rgba(79,184,168,0.13)' : 'rgba(236,229,216,0.07)';
      ctx.lineWidth = 1;
      ctx.stroke();
    }

    // Wave packets, twofold — the brand dichotomy drawn literally:
    // a golden SQUARE wave (the signal, digital) and its smooth sine
    // fundamental in verdigris (the thread, analog), traveling in tandem
    // inside one raised-cosine envelope.
    var VERDIGRIS = '79,184,168';

    function spawnPacket() {
      packets.push({
        t: threads[Math.floor(Math.random() * threads.length)],
        x: -140,
        v: 55 + Math.random() * 45,            // px per second — unhurried
        w: 150 + Math.random() * 70,           // packet width
        amp: 9 + Math.random() * 22,           // amplitude: 1x–3x, varied on purpose
        wl: 26 + Math.random() * 10,           // carrier wavelength
        ph: Math.random(),
      });
    }

    // Square wave in [-1, 1] — the signal carrier.
    function sq(u) {
      return (u - Math.floor(u)) < 0.5 ? 1 : -1;
    }

    function envelopeAt(p, x, half) {
      return 0.5 * (1 + Math.cos(Math.PI * (x - p.x) / half));
    }

    function tracePacket(p, time, half, x0, x1, carrier, ampScale) {
      ctx.beginPath();
      for (var x = x0; x <= x1; x += 2) {
        var u = x / p.wl - time * 1.1 + p.ph;
        var dy = envelopeAt(p, x, half) * p.amp * ampScale * carrier(u);
        var y = threadY(p.t, x, time) + dy;
        x === x0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
      }
    }

    function drawPacket(p, time) {
      var half = p.w / 2;
      var x0 = Math.max(0, p.x - half);
      var x1 = Math.min(W, p.x + half);
      if (x1 <= x0) return;

      // The thread's voice: smooth sine fundamental, verdigris, underneath.
      var tgrad = ctx.createLinearGradient(p.x - half, 0, p.x + half, 0);
      tgrad.addColorStop(0, 'rgba(' + VERDIGRIS + ',0)');
      tgrad.addColorStop(0.5, 'rgba(' + VERDIGRIS + ',0.7)');
      tgrad.addColorStop(1, 'rgba(' + VERDIGRIS + ',0)');
      tracePacket(p, time, half, x0, x1, function (u) {
        return Math.sin(2 * Math.PI * u);
      }, 0.9);
      ctx.strokeStyle = tgrad;
      ctx.lineWidth = 1.2;
      ctx.shadowColor = 'rgba(' + VERDIGRIS + ',0.4)';
      ctx.shadowBlur = 6;
      ctx.stroke();

      // The signal's voice: crisp square wave, gold, on top.
      var sgrad = ctx.createLinearGradient(p.x - half, 0, p.x + half, 0);
      sgrad.addColorStop(0, 'rgba(' + GOLD + ',0)');
      sgrad.addColorStop(0.5, 'rgba(' + GOLD + ',0.9)');
      sgrad.addColorStop(1, 'rgba(' + GOLD + ',0)');
      tracePacket(p, time, half, x0, x1, sq, 1);
      ctx.strokeStyle = sgrad;
      ctx.lineWidth = 1.5;
      ctx.shadowColor = 'rgba(' + GOLD + ',0.55)';
      ctx.shadowBlur = 8;
      ctx.stroke();
      ctx.shadowBlur = 0;

      // Faint stitch ticks keep the weave grounded under both voices.
      var step = p.wl / 2;
      var start = Math.ceil(x0 / step) * step;
      for (var sx = start; sx <= x1; sx += step) {
        var e = envelopeAt(p, sx, half);
        if (e < 0.15) continue;
        var sy = threadY(p.t, sx, time);
        ctx.beginPath();
        ctx.moveTo(sx, sy - 1.5 - 2 * e);
        ctx.lineTo(sx, sy + 1.5 + 2 * e);
        ctx.strokeStyle = 'rgba(' + GOLD + ',' + (0.32 * e).toFixed(2) + ')';
        ctx.lineWidth = 1;
        ctx.stroke();
      }
    }

    var last = 0;
    var spawnTimer = 1.2;

    function frame(now) {
      var time = now / 1000;
      var dt = Math.min(time - last, 0.05);
      last = time;
      ctx.clearRect(0, 0, W, H);

      for (var i = 0; i < threads.length; i++) drawThread(threads[i], time);

      spawnTimer += dt;
      if (spawnTimer > 1.6 && packets.length < 5) {
        spawnTimer = 0;
        spawnPacket();
      }
      for (var j = packets.length - 1; j >= 0; j--) {
        var p = packets[j];
        p.x += p.v * dt;
        if (p.x - p.w > W) {
          packets.splice(j, 1);
        } else {
          drawPacket(p, time);
        }
      }
      requestAnimationFrame(frame);
    }

    resize();
    window.addEventListener('resize', resize);

    if (reduced) {
      // Static weave: threads plus one still golden packet, no motion.
      for (var k = 0; k < threads.length; k++) drawThread(threads[k], 0);
      packets.push({ t: threads[Math.floor(THREADS / 2)], x: W * 0.7, v: 0, w: 170, amp: 11, wl: 26, ph: 0 });
      drawPacket(packets[0], 0);
    } else {
      requestAnimationFrame(function (now) {
        last = now / 1000;
        requestAnimationFrame(frame);
      });
    }
  })();
</script>
