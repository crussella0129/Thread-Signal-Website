---
import { OWNER_NAME, OWNER_LOCATION } from '../data/site';

// The specimen plate (fig. 01): a square wave and its sine fundamental,
// generated at build time so the geometry is exact.
const P = { x0: 30, x1: 350, mid: 112, amp: 30, periods: 3 };
const per = (P.x1 - P.x0) / P.periods;

let sqPath = `M ${P.x0} ${P.mid - P.amp}`;
for (let i = 0; i < P.periods; i++) {
  const a = P.x0 + i * per;
  sqPath += ` H ${(a + per / 2).toFixed(1)} V ${P.mid + P.amp} H ${(a + per).toFixed(1)} V ${P.mid - P.amp}`;
}

const sinePts = Array.from({ length: 97 }, (_, i) => {
  const x = P.x0 + (i / 96) * (P.x1 - P.x0);
  const y = P.mid - P.amp * 0.9 * Math.sin(2 * Math.PI * P.periods * (i / 96));
  return `${x.toFixed(1)},${y.toFixed(1)}`;
}).join(' ');
---

<section class="hero" data-motion="paused">
  <canvas id="loom" aria-hidden="true"></canvas>
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="container hero-content">
    <div class="hero-copy">
      <p class="eyebrow">AI automation &amp; local LLM consulting</p>
      <h1 class="hero-title">
        <span class="ink-gradient">Handwoven</span> automation.
      </h1>
      <p class="hero-sub">
        Turn repetitive work into software your team can run and maintain.
        Custom business automation and local AI agents, built in Rust and Python
        for your workflows and hardware.
      </p>
      <p class="hero-story">
        The first programmable business machine was a loom<br
          class="story-break"
        />
        &mdash; let's build yours.
      </p>
      <div class="hero-cta">
        <a href="/contact" class="btn btn-primary">Commission a build</a>
        <a href="/projects" class="btn btn-outline">See the open source</a>
      </div>
      <p class="hero-byline">
        An independent studio by {OWNER_NAME} · {OWNER_LOCATION}
      </p>
    </div>

    <figure class="hero-plate" aria-hidden="true">
      <svg viewBox="0 0 380 236">
        <defs>
          <pattern
            id="plate-grid"
            width="20"
            height="20"
            patternUnits="userSpaceOnUse"
          >
            <path
              d="M 20 0 H 0 V 20"
              fill="none"
              stroke="currentColor"
              stroke-width="0.5"></path>
          </pattern>
          <linearGradient id="plate-scan-light">
            <stop stop-color="var(--accent)" stop-opacity="0"></stop>
            <stop offset="1" stop-color="var(--accent)" stop-opacity="0.14"
            ></stop>
          </linearGradient>
          <clipPath id="plate-wave-bounds">
            <rect x="30" y="62" width="320" height="100"></rect>
          </clipPath>
          <clipPath id="plate-scan-window">
            <rect class="plate-shuttle" x="-34" y="62" width="64" height="100"
            ></rect>
          </clipPath>
        </defs>
        <rect
          x="1"
          y="1"
          width="378"
          height="234"
          fill="none"
          stroke="currentColor"
          opacity="0.18"></rect>
        <path
          d="M 1 17 V 1 H 17 M 363 235 H 379 V 219"
          class="plate-corners"
          fill="none"></path>
        <rect
          x="30"
          y="62"
          width="320"
          height="100"
          fill="url(#plate-grid)"
          opacity="0.2"></rect>
        <line
          x1={P.x0}
          y1={P.mid}
          x2={P.x1}
          y2={P.mid}
          stroke="currentColor"
          stroke-width="1"
          opacity="0.14"></line>

        <polyline
          points={sinePts}
          fill="none"
          class="plate-sine"
          stroke-width="1.4"></polyline>
        <path d={sqPath} fill="none" class="plate-square" stroke-width="1.6"
        ></path>

        <g clip-path="url(#plate-wave-bounds)" class="plate-scan">
          <g class="plate-shuttle">
            <rect
              x="-34"
              y="62"
              width="64"
              height="100"
              fill="url(#plate-scan-light)"></rect>
            <line x1="30" y1="62" x2="30" y2="162" class="plate-beam"></line>
          </g>
          <g clip-path="url(#plate-scan-window)" class="plate-trace-light">
            <polyline
              points={sinePts}
              fill="none"
              class="plate-sine"
              stroke-width="2.4"></polyline>
            <path d={sqPath} fill="none" class="plate-square" stroke-width="2.4"
            ></path>
          </g>
        </g>

        <text x={P.x0} y="28" class="plate-label plate-label-gold"
          >sq — the signal</text
        >
        <text x={P.x0} y="42" class="plate-label plate-label-thread"
          >sin — the thread</text
        >
        <g class="plate-punches" fill="none" stroke="currentColor">
          {
            [0, 1, 2, 3, 4, 5].map((i) => (
              <rect
                x={280 + i * 13}
                y={i % 2 ? 32 : 22}
                width="4"
                height="8"
                rx="1"
              />
            ))
          }
        </g>

        <line
          x1={P.x0}
          y1="196"
          x2={P.x1}
          y2="196"
          stroke="currentColor"
          stroke-width="1"
          opacity="0.18"></line>
        <rect
          x="186"
          y="192.5"
          width="7"
          height="7"
          transform="rotate(45 189.5 196)"
          fill="none"
          class="plate-node"
          stroke-width="1"></rect>
        <text x={P.x0} y="216" class="plate-label plate-label-muted"
          >FIG. 01 — THREAD &amp; SIGNAL</text
        >
        <text
          x={P.x1}
          y="216"
          text-anchor="end"
          class="plate-label plate-label-muted">EST. 2025</text
        >
      </svg>
      <figcaption class="plate-caption">
        where signal and thread run in tandem
      </figcaption>
    </figure>
  </div>
  <button class="hero-motion" type="button" hidden>
    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
      <path class="motion-pause" d="M 5 3 V 13 M 11 3 V 13"></path>
      <path class="motion-play" d="M 5 3 L 12 8 L 5 13 Z"></path>
    </svg>
    <span>Pause animation</span>
  </button>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(92vh - var(--nav-height));
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  #loom {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: radial-gradient(
      900px 600px at 28% 55%,
      rgba(20, 18, 16, 0.92) 0%,
      rgba(20, 18, 16, 0.55) 55%,
      transparent 100%
    );
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-top: 2rem;
    padding-bottom: var(--space-16);
  }

  .hero-copy {
    max-width: 760px;
  }

  /* The specimen plate: fills the wide-screen right side with the brand
     dichotomy drawn as a technical figure. Hidden below 1200px. */
  .hero-plate {
    display: none;
  }

  @media (min-width: 1200px) {
    .hero-content {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(340px, 460px);
      gap: 5rem;
      align-items: center;
    }

    .hero-plate {
      display: block;
      position: relative;
      margin: 0;
      padding: var(--space-lg) var(--space-lg) var(--space-md);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background:
        radial-gradient(
          ellipse at 100% 0%,
          var(--accent-glow),
          transparent 65%
        ),
        var(--plate-surface);
      backdrop-filter: blur(6px);
      color: var(--text);
      box-shadow: var(--plate-shadow);
      transition:
        transform var(--motion-settle),
        border-color var(--transition);
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .hero-plate:hover {
      transform: perspective(1000px) translateY(-6px) rotateY(-3deg)
        rotateX(2deg);
      border-color: var(--plate-border-active);
    }
  }

  .hero-plate svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .plate-sine {
    stroke: var(--thread);
    opacity: 0.65;
  }

  .plate-square {
    stroke: var(--accent);
    opacity: 0.8;
  }

  .plate-corners,
  .plate-beam {
    stroke: var(--accent);
    stroke-width: 1;
  }

  .plate-punches {
    opacity: 0.45;
    stroke-width: 0.75;
  }

  .plate-trace-light .plate-sine,
  .plate-trace-light .plate-square {
    opacity: 1;
  }

  .plate-scan {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .plate-scan {
      display: block;
    }

    .plate-shuttle {
      animation: shuttle-pass var(--motion-scan) linear infinite;
    }

    .hero[data-motion='paused'] .plate-shuttle {
      animation-play-state: paused;
    }
  }

  @keyframes shuttle-pass {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(384px);
    }
  }

  .hero-motion {
    position: absolute;
    right: var(--space-gutter);
    bottom: var(--space-sm);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    min-height: var(--size-touch-target);
    padding: var(--space-xs) var(--space-sm);
    color: var(--text-muted);
    background: var(--plate-surface);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-pill);
    font: inherit;
    font-size: var(--text-small);
    cursor: pointer;
    transition:
      color var(--transition),
      border-color var(--transition);
  }

  .hero-motion[hidden],
  .motion-play {
    display: none;
  }

  .hero-motion:hover {
    color: var(--text);
    border-color: var(--plate-border-active);
  }

  .hero-motion svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .hero-motion[data-paused='true'] .motion-pause {
    display: none;
  }

  .hero-motion[data-paused='true'] .motion-play {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-plate,
    .hero-motion {
      transition: none;
    }
  }

  .plate-node {
    stroke: var(--accent);
  }

  .plate-label {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.14em;
  }

  .plate-label-gold {
    fill: var(--accent);
  }
  .plate-label-thread {
    fill: var(--thread);
  }
  .plate-label-muted {
    fill: var(--text-muted);
  }

  .plate-caption {
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 450;
    color: var(--text-muted);
    font-size: 0.9rem;
    text-align: center;
    margin-top: 1rem;
  }

  .hero-title {
    margin-bottom: 1.5rem;
  }

  .hero-sub {
    color: var(--text);
    font-size: 1.2rem;
    max-width: 560px;
    margin-bottom: 1.25rem;
    line-height: 1.7;
  }

  .hero-story {
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 450;
    color: var(--text-muted);
    font-size: 1.05rem;
    margin-bottom: 2.5rem;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hero-byline {
    margin-top: var(--space-lg);
    color: var(--text-muted);
    font-size: var(--text-small);
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 82vh;
    }

    .hero-scrim {
      background: radial-gradient(
        140% 90% at 50% 55%,
        rgba(20, 18, 16, 0.9) 0%,
        rgba(20, 18, 16, 0.6) 60%,
        transparent 100%
      );
    }

    .story-break {
      display: none;
    }
  }
</style>

<script is:inline>
  (function () {
    var canvas = document.getElementById('loom');
    if (!canvas || !canvas.getContext) return;
    var ctx = canvas.getContext('2d');
    if (!ctx) return;
    var motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    var reduced = motionQuery.matches;
    var hero = canvas.closest('.hero');
    var motionButton = hero.querySelector('.hero-motion');
    var userPaused = false;
    var inView = true;
    var frameId = null;
    var elapsed = 0;

    var THREADS = 14;
    var GOLD = '232,163,61';
    var threads = [];
    var packets = [];
    var W = 0,
      H = 0,
      dpr = 1;

    function resize() {
      var previousWidth = W;
      dpr = Math.min(window.devicePixelRatio || 1, 1.75);
      W = canvas.clientWidth;
      H = canvas.clientHeight;
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      // Update threads IN PLACE: in-flight packets hold references to these
      // objects, so rebuilding the array on resize would leave packets riding
      // stale, invisible paths (the de-sync bug). Only geometry that depends
      // on the viewport is recomputed; identity and character survive.
      for (var i = 0; i < THREADS; i++) {
        var y = (H * (i + 1)) / (THREADS + 1);
        if (threads[i]) {
          threads[i].y = y;
        } else {
          threads.push({
            y: y,
            amp: 5 + Math.random() * 14,
            wl: 460 + Math.random() * 520,
            phase: Math.random() * Math.PI * 2,
            speed: 0.1 + Math.random() * 0.18, // radians per second
            hue: Math.random() < 0.2 ? 'thread' : 'linen',
          });
        }
      }
      if (previousWidth) {
        for (var j = 0; j < packets.length; j++)
          packets[j].x *= W / previousWidth;
      }
      drawScene();
    }

    function threadY(t, x, time) {
      return t.y + Math.sin(x / t.wl + t.phase + time * t.speed) * t.amp;
    }

    function drawThread(t, time) {
      ctx.beginPath();
      for (var x = 0; x <= W; x += 14) {
        var y = threadY(t, x, time);
        x === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
      }
      ctx.strokeStyle =
        t.hue === 'thread' ? 'rgba(79,184,168,0.13)' : 'rgba(236,229,216,0.07)';
      ctx.lineWidth = 1;
      ctx.stroke();
    }

    // Wave packets, twofold — the brand dichotomy drawn literally:
    // a golden SQUARE wave (the signal, digital) and its smooth sine
    // fundamental in verdigris (the thread, analog), traveling in tandem
    // inside one raised-cosine envelope.
    var VERDIGRIS = '79,184,168';

    function spawnPacket(startX) {
      // One packet per thread, ever: a thread stays occupied until its packet
      // leaves the right edge, so packets can never share or overtake a line.
      var free = threads.filter(function (t) {
        for (var i = 0; i < packets.length; i++) {
          if (packets[i].t === t) return false;
        }
        return true;
      });
      if (!free.length) return;
      packets.push({
        t: free[Math.floor(Math.random() * free.length)],
        x: typeof startX === 'number' ? startX : -140,
        v: 55 + Math.random() * 45, // px per second — unhurried
        w: 150 + Math.random() * 70, // packet width
        amp: 9 + Math.random() * 22, // amplitude: 1x–3x, varied on purpose
        wl: 26 + Math.random() * 10, // carrier wavelength
        ph: Math.random(),
      });
    }

    // Square wave in [-1, 1] — the signal carrier.
    function sq(u) {
      return u - Math.floor(u) < 0.5 ? 1 : -1;
    }

    function envelopeAt(p, x, half) {
      return 0.5 * (1 + Math.cos((Math.PI * (x - p.x)) / half));
    }

    function tracePacket(p, time, half, x0, x1, carrier, ampScale) {
      ctx.beginPath();
      for (var x = x0; x <= x1; x += 2) {
        var u = x / p.wl - time * 1.1 + p.ph;
        var dy = envelopeAt(p, x, half) * p.amp * ampScale * carrier(u);
        var y = threadY(p.t, x, time) + dy;
        x === x0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
      }
    }

    function drawPacket(p, time) {
      var half = p.w / 2;
      var x0 = Math.max(0, p.x - half);
      var x1 = Math.min(W, p.x + half);
      if (x1 <= x0) return;

      // The thread's voice: smooth sine fundamental, verdigris, underneath.
      var tgrad = ctx.createLinearGradient(p.x - half, 0, p.x + half, 0);
      tgrad.addColorStop(0, 'rgba(' + VERDIGRIS + ',0)');
      tgrad.addColorStop(0.5, 'rgba(' + VERDIGRIS + ',0.7)');
      tgrad.addColorStop(1, 'rgba(' + VERDIGRIS + ',0)');
      tracePacket(
        p,
        time,
        half,
        x0,
        x1,
        function (u) {
          return Math.sin(2 * Math.PI * u);
        },
        0.9,
      );
      ctx.strokeStyle = tgrad;
      ctx.lineWidth = 1.2;
      ctx.shadowColor = 'rgba(' + VERDIGRIS + ',0.4)';
      ctx.shadowBlur = 6;
      ctx.stroke();

      // The signal's voice: crisp square wave, gold, on top.
      var sgrad = ctx.createLinearGradient(p.x - half, 0, p.x + half, 0);
      sgrad.addColorStop(0, 'rgba(' + GOLD + ',0)');
      sgrad.addColorStop(0.5, 'rgba(' + GOLD + ',0.9)');
      sgrad.addColorStop(1, 'rgba(' + GOLD + ',0)');
      tracePacket(p, time, half, x0, x1, sq, 1);
      ctx.strokeStyle = sgrad;
      ctx.lineWidth = 1.5;
      ctx.shadowColor = 'rgba(' + GOLD + ',0.55)';
      ctx.shadowBlur = 8;
      ctx.stroke();
      ctx.shadowBlur = 0;

      // Faint stitch ticks keep the weave grounded under both voices.
      var step = p.wl / 2;
      var start = Math.ceil(x0 / step) * step;
      for (var sx = start; sx <= x1; sx += step) {
        var e = envelopeAt(p, sx, half);
        if (e < 0.15) continue;
        var sy = threadY(p.t, sx, time);
        ctx.beginPath();
        ctx.moveTo(sx, sy - 1.5 - 2 * e);
        ctx.lineTo(sx, sy + 1.5 + 2 * e);
        ctx.strokeStyle = 'rgba(' + GOLD + ',' + (0.32 * e).toFixed(2) + ')';
        ctx.lineWidth = 1;
        ctx.stroke();
      }
    }

    var last = 0;
    var spawnTimer = 1.2;

    function drawScene() {
      ctx.clearRect(0, 0, W, H);
      for (var i = 0; i < threads.length; i++) drawThread(threads[i], elapsed);
      for (var j = 0; j < packets.length; j++) drawPacket(packets[j], elapsed);
    }

    function frame(now) {
      var dt = last ? Math.min((now - last) / 1000, 0.05) : 0;
      last = now;
      elapsed += dt;

      spawnTimer += dt;
      if (spawnTimer > 1.6 && packets.length < 6) {
        spawnTimer = 0;
        spawnPacket();
      }
      for (var j = packets.length - 1; j >= 0; j--) {
        var p = packets[j];
        p.x += p.v * dt;
        if (p.x - p.w > W) {
          packets.splice(j, 1);
        }
      }
      drawScene();
      frameId = requestAnimationFrame(frame);
    }

    function syncMotion() {
      var running = !reduced && !userPaused && inView && !document.hidden;
      hero.dataset.motion = running ? 'running' : 'paused';
      motionButton.hidden = reduced;
      motionButton.dataset.paused = String(userPaused);
      motionButton.querySelector('span').textContent = userPaused
        ? 'Play animation'
        : 'Pause animation';
      if (frameId !== null) cancelAnimationFrame(frameId);
      frameId = null;
      last = 0;
      if (running) frameId = requestAnimationFrame(frame);
      else drawScene();
    }

    resize();
    window.addEventListener('resize', resize);

    // Open the loom already working; the same composition is a still image
    // when motion is reduced or paused. Resizing also redraws this still.
    spawnPacket(W * 0.72);
    spawnPacket(W * 0.45);
    spawnPacket(W * 0.18);
    spawnPacket(-140);
    drawScene();
    syncMotion();

    motionButton.addEventListener('click', function () {
      userPaused = !userPaused;
      syncMotion();
    });
    motionQuery.addEventListener('change', function (event) {
      reduced = event.matches;
      syncMotion();
    });
    document.addEventListener('visibilitychange', syncMotion);
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        inView = entries[0].isIntersecting;
        syncMotion();
      }).observe(hero);
    }
  })();
</script>
