<section class="hero">
  <canvas id="loom" aria-hidden="true"></canvas>
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="container hero-content">
    <p class="eyebrow">Agentic development studio</p>
    <h1 class="hero-title">
      <span class="ink-gradient">Handwoven</span> automation.
    </h1>
    <p class="hero-sub">
      Custom AI agents and business process automation — woven in Rust and Python,
      running entirely on hardware you own.
    </p>
    <p class="hero-story">
      The first programmable machine was a loom.<br class="story-break" />
      We've been weaving ever since.
    </p>
    <div class="hero-cta">
      <a href="/contact" class="btn btn-primary">Commission a build</a>
      <a href="/projects" class="btn btn-outline">See the open source</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(92vh - var(--nav-height));
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  #loom {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: radial-gradient(
      900px 600px at 28% 55%,
      rgba(20, 18, 16, 0.92) 0%,
      rgba(20, 18, 16, 0.55) 55%,
      transparent 100%
    );
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 760px;
    margin-left: 0;
    padding-top: 2rem;
    padding-bottom: 2rem;
  }

  .hero-title {
    margin-bottom: 1.5rem;
  }

  .hero-sub {
    color: var(--text);
    font-size: 1.2rem;
    max-width: 560px;
    margin-bottom: 1.25rem;
    line-height: 1.7;
  }

  .hero-story {
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 450;
    color: var(--text-muted);
    font-size: 1.05rem;
    margin-bottom: 2.5rem;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 82vh;
    }

    .hero-scrim {
      background: radial-gradient(
        140% 90% at 50% 55%,
        rgba(20, 18, 16, 0.9) 0%,
        rgba(20, 18, 16, 0.6) 60%,
        transparent 100%
      );
    }

    .story-break {
      display: none;
    }
  }
</style>

<script is:inline>
  (function () {
    var canvas = document.getElementById('loom');
    if (!canvas || !canvas.getContext) return;
    var ctx = canvas.getContext('2d');
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    var THREADS = 16;
    var threads = [];
    var pulses = [];
    var W = 0, H = 0, dpr = 1;

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 1.75);
      W = canvas.clientWidth;
      H = canvas.clientHeight;
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      threads = [];
      for (var i = 0; i < THREADS; i++) {
        threads.push({
          y: (H * (i + 1)) / (THREADS + 1),
          amp: 6 + Math.random() * 18,
          wl: 420 + Math.random() * 520,      // wavelength
          phase: Math.random() * Math.PI * 2,
          speed: 0.00012 + Math.random() * 0.00022,
          hue: Math.random() < 0.18 ? 'thread' : 'linen',
        });
      }
    }

    function threadY(t, x, time) {
      return t.y + Math.sin(x / t.wl + t.phase + time * t.speed * 1000) * t.amp;
    }

    function drawThread(t, time) {
      ctx.beginPath();
      for (var x = 0; x <= W; x += 14) {
        var y = threadY(t, x, time);
        x === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
      }
      ctx.strokeStyle = t.hue === 'thread' ? 'rgba(79,184,168,0.10)' : 'rgba(236,229,216,0.055)';
      ctx.lineWidth = 1;
      ctx.stroke();
    }

    function spawnPulse() {
      var t = threads[Math.floor(Math.random() * threads.length)];
      var r = Math.random();
      pulses.push({
        t: t,
        x: -40,
        v: 90 + Math.random() * 110,           // px per second
        color: r < 0.68 ? '232,163,61' : r < 0.88 ? '79,184,168' : '194,84,63',
      });
    }

    function drawPulse(p, time) {
      var y = threadY(p.t, p.x, time);
      var tail = 90;
      var grad = ctx.createLinearGradient(p.x - tail, y, p.x, y);
      grad.addColorStop(0, 'rgba(' + p.color + ',0)');
      grad.addColorStop(1, 'rgba(' + p.color + ',0.55)');
      ctx.beginPath();
      for (var x = Math.max(0, p.x - tail); x <= Math.min(W, p.x); x += 8) {
        var yy = threadY(p.t, x, time);
        x <= Math.max(0, p.x - tail) ? ctx.moveTo(x, yy) : ctx.lineTo(x, yy);
      }
      ctx.strokeStyle = grad;
      ctx.lineWidth = 1.6;
      ctx.stroke();

      ctx.beginPath();
      ctx.arc(p.x, y, 2.2, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(' + p.color + ',0.95)';
      ctx.shadowColor = 'rgba(' + p.color + ',0.8)';
      ctx.shadowBlur = 10;
      ctx.fill();
      ctx.shadowBlur = 0;
    }

    var last = 0;
    var pulseTimer = 0;

    function frame(now) {
      var dt = Math.min((now - last) / 1000, 0.05);
      last = now;
      ctx.clearRect(0, 0, W, H);

      for (var i = 0; i < threads.length; i++) drawThread(threads[i], now);

      pulseTimer += dt;
      if (pulseTimer > 0.9 && pulses.length < 7) {
        pulseTimer = 0;
        spawnPulse();
      }
      for (var j = pulses.length - 1; j >= 0; j--) {
        var p = pulses[j];
        p.x += p.v * dt;
        if (p.x - 100 > W) {
          pulses.splice(j, 1);
        } else {
          drawPulse(p, now);
        }
      }
      requestAnimationFrame(frame);
    }

    resize();
    window.addEventListener('resize', resize);

    if (reduced) {
      // Static weave: threads only, one still frame, no pulses.
      for (var k = 0; k < threads.length; k++) drawThread(threads[k], 0);
    } else {
      requestAnimationFrame(function (now) {
        last = now;
        requestAnimationFrame(frame);
      });
    }
  })();
</script>
