<section class="hero">
  <canvas id="loom" aria-hidden="true"></canvas>
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="container hero-content">
    <p class="eyebrow">Agentic development studio</p>
    <h1 class="hero-title">
      <span class="ink-gradient">Handwoven</span> automation.
    </h1>
    <p class="hero-sub">
      Custom AI agents and business process automation — woven in Rust and Python,
      running entirely on hardware you own.
    </p>
    <p class="hero-story">
      The first programmable machine was a loom.<br class="story-break" />
      We've been weaving ever since.
    </p>
    <div class="hero-cta">
      <a href="/contact" class="btn btn-primary">Commission a build</a>
      <a href="/projects" class="btn btn-outline">See the open source</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(92vh - var(--nav-height));
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  #loom {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: radial-gradient(
      900px 600px at 28% 55%,
      rgba(20, 18, 16, 0.92) 0%,
      rgba(20, 18, 16, 0.55) 55%,
      transparent 100%
    );
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 760px;
    margin-left: 0;
    padding-top: 2rem;
    padding-bottom: 2rem;
  }

  .hero-title {
    margin-bottom: 1.5rem;
  }

  .hero-sub {
    color: var(--text);
    font-size: 1.2rem;
    max-width: 560px;
    margin-bottom: 1.25rem;
    line-height: 1.7;
  }

  .hero-story {
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 450;
    color: var(--text-muted);
    font-size: 1.05rem;
    margin-bottom: 2.5rem;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 82vh;
    }

    .hero-scrim {
      background: radial-gradient(
        140% 90% at 50% 55%,
        rgba(20, 18, 16, 0.9) 0%,
        rgba(20, 18, 16, 0.6) 60%,
        transparent 100%
      );
    }

    .story-break {
      display: none;
    }
  }
</style>

<script is:inline>
  (function () {
    var canvas = document.getElementById('loom');
    if (!canvas || !canvas.getContext) return;
    var ctx = canvas.getContext('2d');
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    var THREADS = 14;
    var GOLD = '232,163,61';
    var threads = [];
    var packets = [];
    var W = 0, H = 0, dpr = 1;

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 1.75);
      W = canvas.clientWidth;
      H = canvas.clientHeight;
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      threads = [];
      for (var i = 0; i < THREADS; i++) {
        threads.push({
          y: (H * (i + 1)) / (THREADS + 1),
          amp: 5 + Math.random() * 14,
          wl: 460 + Math.random() * 520,
          phase: Math.random() * Math.PI * 2,
          speed: 0.1 + Math.random() * 0.18,   // radians per second
          hue: Math.random() < 0.2 ? 'thread' : 'linen',
        });
      }
    }

    function threadY(t, x, time) {
      return t.y + Math.sin(x / t.wl + t.phase + time * t.speed) * t.amp;
    }

    function drawThread(t, time) {
      ctx.beginPath();
      for (var x = 0; x <= W; x += 14) {
        var y = threadY(t, x, time);
        x === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
      }
      ctx.strokeStyle = t.hue === 'thread' ? 'rgba(79,184,168,0.13)' : 'rgba(236,229,216,0.07)';
      ctx.lineWidth = 1;
      ctx.stroke();
    }

    // Golden wave packets: a textile waveform — triangular (zigzag) carrier
    // inside a raised-cosine envelope — traveling along a thread, with
    // stitch ticks marking the weave.
    function spawnPacket() {
      packets.push({
        t: threads[Math.floor(Math.random() * threads.length)],
        x: -120,
        v: 55 + Math.random() * 45,            // px per second — unhurried
        w: 130 + Math.random() * 70,           // packet width
        amp: 9 + Math.random() * 6,            // displacement amplitude
        wl: 22 + Math.random() * 8,            // carrier zigzag wavelength
        ph: Math.random(),
      });
    }

    // Triangle (zigzag) wave in [-1, 1] — the woven carrier.
    function zig(u) {
      var f = u - Math.floor(u);
      return 4 * Math.abs(f - 0.5) - 1;
    }

    function drawPacket(p, time) {
      var half = p.w / 2;
      var x0 = Math.max(0, p.x - half);
      var x1 = Math.min(W, p.x + half);
      if (x1 <= x0) return;

      // Horizontal gradient tracks the envelope: sheer at the selvages,
      // golden at the heart of the packet.
      var grad = ctx.createLinearGradient(p.x - half, 0, p.x + half, 0);
      grad.addColorStop(0, 'rgba(' + GOLD + ',0)');
      grad.addColorStop(0.5, 'rgba(' + GOLD + ',0.9)');
      grad.addColorStop(1, 'rgba(' + GOLD + ',0)');

      ctx.beginPath();
      for (var x = x0; x <= x1; x += 3) {
        var env = 0.5 * (1 + Math.cos(Math.PI * (x - p.x) / half));
        var dy = env * p.amp * zig(x / p.wl - time * 1.1 + p.ph);
        var y = threadY(p.t, x, time) + dy;
        x === x0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
      }
      ctx.strokeStyle = grad;
      ctx.lineWidth = 1.5;
      ctx.shadowColor = 'rgba(' + GOLD + ',0.55)';
      ctx.shadowBlur = 8;
      ctx.stroke();
      ctx.shadowBlur = 0;

      // Stitch ticks: short weft marks pinned to the weave, strongest at
      // the packet's heart.
      var step = p.wl / 2;
      var start = Math.ceil(x0 / step) * step;
      for (var sx = start; sx <= x1; sx += step) {
        var e = 0.5 * (1 + Math.cos(Math.PI * (sx - p.x) / half));
        if (e < 0.12) continue;
        var sy = threadY(p.t, sx, time);
        ctx.beginPath();
        ctx.moveTo(sx, sy - 2 - 2.5 * e);
        ctx.lineTo(sx, sy + 2 + 2.5 * e);
        ctx.strokeStyle = 'rgba(' + GOLD + ',' + (0.5 * e).toFixed(2) + ')';
        ctx.lineWidth = 1;
        ctx.stroke();
      }
    }

    var last = 0;
    var spawnTimer = 1.2;

    function frame(now) {
      var time = now / 1000;
      var dt = Math.min(time - last, 0.05);
      last = time;
      ctx.clearRect(0, 0, W, H);

      for (var i = 0; i < threads.length; i++) drawThread(threads[i], time);

      spawnTimer += dt;
      if (spawnTimer > 1.6 && packets.length < 5) {
        spawnTimer = 0;
        spawnPacket();
      }
      for (var j = packets.length - 1; j >= 0; j--) {
        var p = packets[j];
        p.x += p.v * dt;
        if (p.x - p.w > W) {
          packets.splice(j, 1);
        } else {
          drawPacket(p, time);
        }
      }
      requestAnimationFrame(frame);
    }

    resize();
    window.addEventListener('resize', resize);

    if (reduced) {
      // Static weave: threads plus one still golden packet, no motion.
      for (var k = 0; k < threads.length; k++) drawThread(threads[k], 0);
      packets.push({ t: threads[Math.floor(THREADS / 2)], x: W * 0.7, v: 0, w: 170, amp: 11, wl: 26, ph: 0 });
      drawPacket(packets[0], 0);
    } else {
      requestAnimationFrame(function (now) {
        last = now / 1000;
        requestAnimationFrame(frame);
      });
    }
  })();
</script>
