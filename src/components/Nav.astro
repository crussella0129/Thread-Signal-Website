---
import { Image } from "astro:assets";
import { SITE_NAME, PHONE_DISPLAY, TEL_URL } from "../data/site";
import lockup from "../assets/logo/thread-and-signal-lockup-white.png";
// The logo is the Home link; Open-Source Dev lives in the footer.
const links = [
  { href: "/how-it-works/", label: "How It Works" },
  { href: "/founders-club/", label: "Founders Club" },
  { href: "/contact/", label: "About" },
];
const trim = (path: string) => path.replace(/\/$/, "") || "/";
const path = trim(Astro.url.pathname);
---

<header class="site-header container">
  <a
    class="wordmark"
    href="/"
    aria-current={path === "/" ? "page" : undefined}
  >
    <Image
      src={lockup}
      alt={SITE_NAME}
      height={32}
      densities={[1, 2, 3]}
      loading="eager"
      decoding="sync"
    />
  </a>
  <nav class="site-nav" aria-label="Main navigation">
    {
      links.map(({ href, label }) => (
        <a
          href={href}
          aria-current={path === trim(href) ? "page" : undefined}
          set:text={label}
        />
      ))
    }
  </nav>
  <a
    class="header-phone"
    href={TEL_URL}
    aria-label={`Call Charles at ${PHONE_DISPLAY}`}
    set:text={PHONE_DISPLAY}
  />
</header>
<style>
  .site-header {
    display: grid;
    grid-template-columns: max-content 1fr auto;
    align-items: center;
    column-gap: var(--s6);
    padding-block: var(--s6);
  }
  /* Signalium clear space: half the lockup's height on every side. */
  .wordmark {
    display: block;
    padding-block: var(--s2);
  }
  .wordmark img {
    display: block;
    height: var(--logo-height);
    width: auto;
    max-width: none;
  }
  .site-nav {
    justify-self: end;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s1);
  }
  .site-nav a {
    display: flex;
    align-items: center;
    min-height: var(--target);
    padding: var(--s2) var(--s3);
    border-radius: var(--radius);
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
  }
  .site-nav a[aria-current="page"] {
    color: var(--text);
    background: var(--surface);
  }
  .header-phone {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    padding-inline: var(--s3);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }
  @media (hover: hover) and (pointer: fine) {
    .site-nav a:hover,
    .header-phone:hover {
      color: var(--text);
      text-decoration: underline;
    }
  }
  @media (max-width: 940px) {
    .site-header {
      grid-template-columns: max-content 1fr;
      row-gap: var(--s1);
      padding-block: var(--s4) var(--s2);
    }
    .header-phone {
      grid-column: 2;
      grid-row: 1;
      justify-self: end;
      padding-inline: 0;
    }
    .site-nav {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-self: start;
      margin-inline-start: calc(var(--s3) * -1);
    }
  }
  @media (max-width: 540px) {
    .site-nav a {
      padding-inline: var(--s2);
    }
    .site-nav {
      margin-inline-start: calc(var(--s2) * -1);
    }
  }
  @media (max-width: 359px) {
    .header-phone {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-self: start;
    }
    .site-nav {
      grid-row: 3;
    }
  }
</style>
