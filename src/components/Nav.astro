---
import { Image } from "astro:assets";
import { SITE_NAME } from "../data/site";
import lockup from "../assets/logo/thread-and-signal-lockup-white.png";
const links = [
  { href: "/", label: "Home" },
  { href: "/services/", label: "Services Offered" },
  { href: "/open-source/", label: "Open-Source Dev" },
  { href: "/contact/", label: "About & Contact" },
];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="site-header container">
  <a class="wordmark" href="/">
    <Image
      src={lockup}
      alt={SITE_NAME}
      height={32}
      densities={[1, 2, 3]}
      loading="eager"
    />
  </a>
  <nav class="site-nav" aria-label="Main navigation">
    {
      links.map(({ href, label }) => (
        <a
          href={href}
          aria-current={
            path === (href.replace(/\/$/, "") || "/") ? "page" : undefined
          }
        >
          {label}
        </a>
      ))
    }
  </nav>
</header>
<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s6);
    padding-block: var(--s6);
  }
  /* Signalium clear space: half the lockup's height on every side. */
  .wordmark {
    flex-shrink: 0;
    display: block;
    padding-block: var(--s2);
  }
  .wordmark img {
    display: block;
    height: var(--logo-height);
    width: auto;
  }
  .site-nav {
    display: flex;
    gap: var(--s1);
  }
  .site-nav a {
    display: flex;
    align-items: center;
    min-height: var(--target);
    padding: var(--s2) var(--s3);
    border-radius: var(--radius);
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
  }
  .site-nav a[aria-current="page"] {
    color: var(--text);
    background: var(--surface);
  }
  .site-nav a:hover {
    color: var(--text);
    text-decoration: underline;
  }
  @media (max-width: 900px) {
    .site-header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--s4);
    }
  }
  @media (max-width: 540px) {
    .site-nav {
      flex-wrap: wrap;
      width: 100%;
    }
    .site-nav a {
      padding-inline: var(--s2);
    }
  }
</style>
