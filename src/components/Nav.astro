---
const currentPath = Astro.url.pathname;

const links = [
  { href: '/services', label: 'Services' },
  { href: '/animus', label: 'Animus' },
  { href: '/skills', label: 'Skills' },
  { href: '/design', label: 'Design' },
  { href: '/projects', label: 'Projects' },
  { href: '/blog', label: 'Blog' },
  { href: '/contact', label: 'Contact' },
];
---

<nav class="nav">
  <div class="container nav-inner">
    <a href="/" class="nav-logo">
      <span class="logo-word">Thread</span>
      <span class="logo-amp">&amp;</span>
      <span class="logo-word">Signal</span>
    </a>

    <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false">
      <span class="hamburger"></span>
    </button>

    <ul class="nav-links">
      {links.map(link => (
        <li>
          <a
            href={link.href}
            class:list={['nav-link', { active: currentPath === link.href }]}
          >
            {link.label}
          </a>
        </li>
      ))}
      <li class="nav-cta-item">
        <a href="/contact" class="nav-cta">Commission a build</a>
      </li>
    </ul>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--nav-height);
    border-bottom: 1px solid var(--border);
    z-index: 1000;
  }

  /* The blur lives on a pseudo-element, not on .nav itself. An element with
     backdrop-filter becomes the containing block for its position:fixed
     descendants — which would trap the mobile drawer inside the 76px-tall
     bar instead of letting it cover the viewport. Painting the blur here
     keeps .nav a plain fixed element so the drawer resolves to the viewport. */
  .nav::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(20, 18, 16, 0.82);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    z-index: -1;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .nav-logo {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    color: var(--text);
  }

  .nav-logo:hover { color: var(--text); }

  .logo-word { color: var(--text); }

  .logo-amp {
    color: var(--accent);
    font-style: italic;
    font-weight: 450;
  }

  .nav-links {
    display: flex;
    align-items: center;
    list-style: none;
    gap: 0.35rem;
  }

  .nav-link {
    position: relative;
    padding: 0.5rem 0.85rem;
    color: var(--text-muted);
    font-size: 0.92rem;
    font-weight: 500;
    transition: color var(--transition);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0.85rem;
    right: 0.85rem;
    bottom: 0.15rem;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--transition);
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--text);
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    transform: scaleX(1);
  }

  .nav-link.active {
    color: var(--accent);
  }

  .nav-cta-item {
    margin-left: 0.75rem;
  }

  .nav-cta {
    display: inline-block;
    padding: 0.5rem 1.1rem;
    border-radius: 9px;
    font-size: 0.88rem;
    font-weight: 600;
    color: #241a09;
    background: linear-gradient(180deg, #f0b355, var(--accent));
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.25) inset;
    transition: transform var(--transition), box-shadow var(--transition);
  }

  .nav-cta:hover {
    color: #241a09;
    transform: translateY(-1px);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.25) inset, 0 8px 20px rgba(232, 163, 61, 0.28);
  }

  .nav-toggle {
    display: none;
    position: relative;
    z-index: 1;                 /* stays above the open drawer so it can close it */
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    border-radius: 6px;
  }

  .nav-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .hamburger,
  .hamburger::before,
  .hamburger::after {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--text);
    transition: transform var(--transition), opacity var(--transition), top var(--transition);
  }

  .hamburger {
    position: relative;
  }

  .hamburger::before,
  .hamburger::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .hamburger::before { top: -7px; }
  .hamburger::after { top: 7px; }

  /* Open: the bars fold into an ✕ so there's a clear way back out. */
  .nav-toggle[aria-expanded='true'] .hamburger {
    background: transparent;
  }

  .nav-toggle[aria-expanded='true'] .hamburger::before {
    top: 0;
    transform: rotate(45deg);
  }

  .nav-toggle[aria-expanded='true'] .hamburger::after {
    top: 0;
    transform: rotate(-45deg);
  }

  @media (max-width: 900px) {
    .nav-toggle {
      display: block;
    }

    .nav-links {
      position: fixed;
      top: var(--nav-height);
      left: 0;
      right: 0;
      bottom: 0;
      flex-direction: column;
      align-items: stretch;
      background: var(--bg);
      padding: 2rem 1.5rem;
      gap: 0.5rem;
      transform: translateX(100%);
      transition: transform var(--transition);
    }

    .nav-links.open {
      transform: translateX(0);
    }

    .nav-link {
      font-size: 1.1rem;
      padding: 0.75rem 1rem;
      display: block;
    }

    .nav-link::after {
      display: none;
    }

    .nav-cta-item {
      margin-left: 0;
      margin-top: 1rem;
    }

    .nav-cta {
      display: block;
      text-align: center;
      padding: 0.85rem 1.1rem;
      font-size: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link::after,
    .nav-cta,
    .nav-links,
    .hamburger,
    .hamburger::before,
    .hamburger::after {
      transition: none;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const links = document.querySelector<HTMLUListElement>('.nav-links');
  const MOBILE = 900;

  function setOpen(open: boolean) {
    if (!toggle || !links) return;
    toggle.setAttribute('aria-expanded', String(open));
    links.classList.toggle('open', open);
    // Lock the page behind the full-screen drawer so it doesn't scroll through.
    document.body.style.overflow = open ? 'hidden' : '';
  }

  toggle?.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  // Tapping a destination closes the drawer (and clears the scroll lock before
  // the next page paints).
  links?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => setOpen(false));
  });

  // Escape closes it — expected of any overlay.
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });

  // Crossing back to desktop must clear both the open state and the scroll lock,
  // or the body stays frozen after a resize/rotate.
  window.addEventListener('resize', () => {
    if (window.innerWidth > MOBILE) setOpen(false);
  });
</script>
